---
/**
 * NoRec.US QR safety lesson card.
 *
 * Non-blocking by design: the page remains readable and scrollable.
 * Audio starts only after an explicit click/tap and is served locally.
 * No cookies, localStorage, analytics, external requests, or third-party players.
 */
---

<link rel="stylesheet" href="/styles/qr-lesson.css" />

<aside
  id="qr-lesson-card"
  class="qr-lesson-card"
  role="dialog"
  aria-labelledby="qr-lesson-title"
  aria-describedby="qr-lesson-description"
>
  <p class="qr-lesson-label">HARMLESS DEMONSTRATION</p>
  <h2 id="qr-lesson-title">A QR code just asked you to trust it.</h2>
  <p id="qr-lesson-description">
    This one is NoRec.US. Want a memorable demonstration of why blindly trusting
    whatever a QR code opens can still be a bad habit?
  </p>

  <div class="qr-lesson-actions">
    <button id="qr-lesson-yes" class="qr-lesson-button qr-lesson-yes" type="button">
      SHOW ME
    </button>
    <button id="qr-lesson-no" class="qr-lesson-button qr-lesson-no" type="button">
      DISMISS
    </button>
  </div>
</aside>

<audio
  id="qr-lesson-audio"
  preload="none"
  loop
  data-playlist="/audio/nggyu-dnb.mp3,/audio/nggyu-pop.mp3"
></audio>

<button
  id="qr-lesson-stop"
  class="qr-lesson-stop"
  type="button"
  aria-label="Stop audio"
  title="Stop audio"
  hidden
>
  <span class="qr-lesson-stop-icon" aria-hidden="true">■</span>
  <span class="qr-lesson-stop-label">STOP</span>
</button>

<script src="/scripts/qr-lesson.js" defer></script>
