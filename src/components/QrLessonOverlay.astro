<!--
  NoRec.US QR lesson overlay

  IMPORTANT: The production CSP is `script-src 'self'; style-src 'self'`.
  Keep the behavior and styles in same-origin external files under public/.
  Do not move these back into inline <script is:inline> or <style> blocks.
-->

<link rel="stylesheet" href="/styles/qr-lesson.css" />

<div
  id="qr-lesson-modal"
  class="qr-lesson-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="qr-lesson-title"
  aria-describedby="qr-lesson-description"
>
  <div class="qr-lesson-card" role="document">
    <p class="qr-lesson-label">QR SAFETY</p>

    <h2 id="qr-lesson-title">Want to hear more?</h2>
    <p id="qr-lesson-description">
      Would you like to hear more about the dangers of scanning unknown QR codes
      and clicking unfamiliar links?
    </p>

    <div class="qr-lesson-actions">
      <button id="qr-lesson-yes" class="qr-lesson-button qr-lesson-yes" type="button">
        YES
      </button>

      <button id="qr-lesson-no" class="qr-lesson-button qr-lesson-no" type="button">
        NO
      </button>
    </div>
  </div>
</div>

<audio id="qr-lesson-audio" preload="none" loop></audio>

<button
  id="qr-lesson-stop"
  class="qr-lesson-stop"
  type="button"
  aria-label="Stop audio"
  title="Stop audio"
  hidden
>
  <span class="qr-lesson-stop-icon" aria-hidden="true">■</span>
  <span class="qr-lesson-stop-label">STOP</span>
</button>

<!-- Same-origin external script: allowed by the production CSP. -->
<script is:inline src="/scripts/qr-lesson.js"></script>
