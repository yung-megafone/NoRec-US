---
import fs from 'node:fs';
import path from 'node:path';

const {
  county,
  municipalities,
  height = 560,
} = Astro.props;

const countyName = String(county);
const countySlug = countyName.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const mapId = `municipality-map-${countySlug}`;
const clipId = `${mapId}-county-clip`;

const clientMunicipalities = municipalities.map((m: any) => ({
  name: String(m.name),
  slug: String(m.slug),
  status: String(m.status),
  crossCounty: Boolean(m.crossCounty),
  href: `/illinois/counties/${countySlug}/cities/${m.slug}/`,
}));

const countyBoundaryPath = path.resolve(
  process.cwd(),
  'public/archive/illinois/reference/county-boundaries-current.geojson',
);
const municipalBoundaryPath = path.resolve(
  process.cwd(),
  'public/archive/illinois/reference/municipal-boundaries-current.geojson',
);

// Illinois' municipal source data uses a number of abbreviated or legacy
// labels. Keep source-name differences isolated here so public jurisdiction
// names remain correct.
const sourceNameAliases: Record<string, string> = {
  'Caledonia': 'NORTH CALEDONIA',
  'Mount Carroll': 'MT CARROLL',
  'Arlington Heights': 'ARLINGTON HTS',
  'Chicago Heights': 'CHICAGO HTS',
  'East Hazel Crest': 'EAST HAZELCREST',
  'Elk Grove Village': 'ELK GROVE',
  'Forest View': 'FORESTVIEW',
  'Harwood Heights': 'HARWOOD HTS',
  'Hazel Crest': 'HAZELCREST',
  'Indian Head Park': 'INDIAN HEAD',
  'La Grange Park': 'LAGRANGE PARK',
  'La Grange': 'LAGRANGE',
  'Mount Prospect': 'MT PROSPECT',
  'Northlake': 'NORTH LAKE',
  'Palos Heights': 'PALOS HTS',
  'Prospect Heights': 'PROSPECT HTS',
  'South Chicago Heights': 'SOUTH CHICAGO HTS',
  'Glendale Heights': 'GLENDALE HTS',
  'St. Charles': 'ST CHARLES',
  'North Aurora': 'NO AURORA',
  'South Elgin': 'SO ELGIN',
  'North Barrington': 'N BARRINGTON',
  'Round Lake Beach': 'ROUND LAKE BCH',
  'Round Lake Heights': 'ROUND LAKE HTS',
  'Mount Morris': 'MT MORRIS',
  'New Milford': 'MILFORD',
};

const normalizeSourceName = (value: string) =>
  String(value)
    .normalize('NFKD')
    .replace(/[’']/g, '')
    .replace(/[^A-Za-z0-9]+/g, '')
    .toUpperCase();

const ringsFromGeometry = (geometry: any): number[][][] => {
  if (!geometry) return [];
  if (geometry.type === 'Polygon') return geometry.coordinates ?? [];
  if (geometry.type === 'MultiPolygon') return (geometry.coordinates ?? []).flat();
  return [];
};

const allPoints = (geometry: any): number[][] => ringsFromGeometry(geometry).flat();

const boundsFromPoints = (points: number[][]) => {
  let minX = Infinity;
  let maxX = -Infinity;
  let minY = Infinity;
  let maxY = -Infinity;
  for (const point of points) {
    const x = Number(point?.[0]);
    const y = Number(point?.[1]);
    if (!Number.isFinite(x) || !Number.isFinite(y)) continue;
    if (x < minX) minX = x;
    if (x > maxX) maxX = x;
    if (y < minY) minY = y;
    if (y > maxY) maxY = y;
  }
  return { minX, maxX, minY, maxY };
};

const simplifyProjectedRing = (
  ring: number[][],
  project: (point: number[]) => number[],
  tolerance = 0.75,
) => {
  if (!Array.isArray(ring) || ring.length <= 4) return ring ?? [];
  const toleranceSq = tolerance * tolerance;
  const simplified: number[][] = [ring[0]];
  let lastProjected = project(ring[0]);

  for (let index = 1; index < ring.length - 1; index += 1) {
    const point = ring[index];
    const projected = project(point);
    const dx = projected[0] - lastProjected[0];
    const dy = projected[1] - lastProjected[1];
    if (dx * dx + dy * dy >= toleranceSq) {
      simplified.push(point);
      lastProjected = projected;
    }
  }

  simplified.push(ring[ring.length - 1]);
  return simplified.length >= 4 ? simplified : ring;
};

let mapError = '';
let countyPath = '';
let municipalityShapes: Array<{
  name: string;
  href: string;
  className: string;
  title: string;
  path: string;
}> = [];

try {
  if (!fs.existsSync(countyBoundaryPath)) {
    throw new Error('Local county boundary dataset is missing');
  }
  if (!fs.existsSync(municipalBoundaryPath)) {
    throw new Error('Local municipal boundary dataset is missing');
  }

  const countyData = JSON.parse(fs.readFileSync(countyBoundaryPath, 'utf8'));
  const municipalityData = JSON.parse(fs.readFileSync(municipalBoundaryPath, 'utf8'));

  if (countyData?.type !== 'FeatureCollection' || !Array.isArray(countyData?.features)) {
    throw new Error('Local county boundary dataset is not a valid GeoJSON FeatureCollection');
  }
  if (municipalityData?.type !== 'FeatureCollection' || !Array.isArray(municipalityData?.features)) {
    throw new Error('Local municipal boundary dataset is not a valid GeoJSON FeatureCollection');
  }

  const countyNormalized = normalizeSourceName(countyName);
  const countyFeature = countyData.features.find((feature: any) => {
    if (!feature?.geometry) return false;
    return normalizeSourceName(feature?.properties?.COUNTY_NAM ?? '') === countyNormalized;
  });

  if (!countyFeature?.geometry) {
    throw new Error('County boundary was not found in the local Illinois dataset');
  }

  const points = allPoints(countyFeature.geometry);
  if (!points.length) {
    throw new Error('County boundary contains no drawable points');
  }

  const { minX, maxX, minY, maxY } = boundsFromPoints(points);

  const width = 1000;
  const svgHeight = 700;
  const pad = 32;
  const spanX = Math.max(maxX - minX, 0.00001);
  const spanY = Math.max(maxY - minY, 0.00001);
  const sx = (width - pad * 2) / spanX;
  const sy = (svgHeight - pad * 2) / spanY;
  const scale = Math.min(sx, sy);
  const offsetX = (width - spanX * scale) / 2;
  const offsetY = (svgHeight - spanY * scale) / 2;

  const project = ([x, y]: number[]) => [
    offsetX + (x - minX) * scale,
    svgHeight - (offsetY + (y - minY) * scale),
  ];

  const pathFor = (geometry: any) =>
    ringsFromGeometry(geometry)
      .map(
        (ring) =>
          simplifyProjectedRing(ring, project)
            .map((point, index) => {
              const [x, y] = project(point);
              return `${index === 0 ? 'M' : 'L'}${x.toFixed(2)},${y.toFixed(2)}`;
            })
            .join(' ') + ' Z',
      )
      .join(' ');

  countyPath = pathFor(countyFeature.geometry);

  const municipalFeaturesByName = new Map<string, any[]>();
  for (const feature of municipalityData.features) {
    if (!feature?.geometry) continue;
    const sourceName = feature?.properties?.DISTRICTNA;
    if (!sourceName) continue;
    const key = normalizeSourceName(sourceName);
    const existing = municipalFeaturesByName.get(key) ?? [];
    existing.push(feature);
    municipalFeaturesByName.set(key, existing);
  }

  municipalityShapes = clientMunicipalities
    .map((item: any) => {
      const requestedSourceName = sourceNameAliases[item.name] ?? item.name;
      const features = municipalFeaturesByName.get(normalizeSourceName(requestedSourceName)) ?? [];
      if (!features.length) return null;

      return {
        name: item.name,
        href: item.href,
        className: `jurisdiction_municipality jurisdiction_municipality_${item.status}${
          item.crossCounty ? ' jurisdiction_municipality_cross_county' : ''
        }`,
        title: `${item.name}${item.crossCounty ? ' · crosses county line' : ''} · ${
          item.status === 'documented' || item.status === 'partial'
            ? 'research available'
            : 'research needed'
        }`,
        path: features.map((feature: any) => pathFor(feature.geometry)).join(' '),
      };
    })
    .filter(Boolean);
} catch (error) {
  mapError =
    error instanceof Error
      ? error.message
      : 'The local Illinois boundary datasets could not be read during the site build.';
  console.warn(`[NoRec map] ${countyName} County: ${mapError}`);
}
---

{
  countyPath ? (
    <div
      class="jurisdiction_map jurisdiction_map_loaded"
      id={mapId}
      style={`--jurisdiction-map-height:${height}px`}
    >
      <div class="jurisdiction_map_status">
        {countyName} County · click a municipal boundary to open its dossier
      </div>

      <svg
        class="jurisdiction_map_svg"
        viewBox="0 0 1000 700"
        role="img"
        aria-label={`${countyName} County municipal boundary map`}
      >
        <defs>
          <clipPath id={clipId}>
            <path d={countyPath} fill-rule="evenodd" />
          </clipPath>
        </defs>

        <path
          d={countyPath}
          class="jurisdiction_county_fill"
          fill-rule="evenodd"
        />

        {
          municipalityShapes.map((shape) => (
            <a href={shape.href} aria-label={shape.title}>
              <path
                d={shape.path}
                clip-path={`url(#${clipId})`}
                fill-rule="evenodd"
                class={shape.className}
              >
                <title>{shape.title}</title>
              </path>
            </a>
          ))
        }

        <path
          d={countyPath}
          class="jurisdiction_county_outline"
          fill-rule="evenodd"
        />
      </svg>
    </div>
  ) : (
    <div class="jurisdiction_map jurisdiction_map_error" id={mapId}>
      <div class="jurisdiction_map_status jurisdiction_map_status_error">
        Boundary map unavailable for this build. Use the municipality directory below.
      </div>
    </div>
  )
}
