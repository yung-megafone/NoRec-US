---
const {
  county,
  municipalities,
  height = 560,
} = Astro.props;

const countyName = String(county);
const countyUpper = countyName.toUpperCase();
const countySlug = countyName.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const mapId = `municipality-map-${countySlug}`;
const clipId = `${mapId}-county-clip`;

const clientMunicipalities = municipalities.map((m: any) => ({
  name: String(m.name),
  slug: String(m.slug),
  status: String(m.status),
  crossCounty: Boolean(m.crossCounty),
  href: `/illinois/counties/${countySlug}/cities/${m.slug}/`,
}));

const countyService =
  'https://maps.dnr.illinois.gov/geoservices/rest/services/BaseLayers/MapServer/10/query';
const municipalityService =
  'https://maps.dnr.illinois.gov/geoservices/rest/services/BaseLayers/MapServer/23/query';

const escapeSql = (value: string) => String(value).replaceAll("'", "''");

const ringsFromGeometry = (geometry: any): number[][][] => {
  if (!geometry) return [];
  if (geometry.type === 'Polygon') return geometry.coordinates ?? [];
  if (geometry.type === 'MultiPolygon') return (geometry.coordinates ?? []).flat();
  return [];
};

const allPoints = (geometry: any): number[][] => ringsFromGeometry(geometry).flat();

const postArcGis = async (url: string, params: Record<string, string>) => {
  const response = await fetch(url, {
    method: 'POST',
    headers: {
      Accept: 'application/geo+json,application/json',
      'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
    },
    body: new URLSearchParams(params),
  });

  if (!response.ok) {
    throw new Error(`ArcGIS request failed: ${response.status} ${response.statusText}`);
  }

  const data = await response.json();
  if (data?.error) {
    throw new Error(data.error?.message ?? 'ArcGIS returned an error');
  }
  return data;
};

let mapError = '';
let countyPath = '';
let municipalityShapes: Array<{
  name: string;
  href: string;
  className: string;
  title: string;
  path: string;
}> = [];

try {
  const municipalityWhere = clientMunicipalities
    .flatMap((item: any) => [
      `DISTRICTNA='${escapeSql(item.name)}'`,
      `DISTRICTNA='${escapeSql(item.name.toUpperCase())}'`,
    ])
    .join(' OR ');

  const [countyData, municipalityData] = await Promise.all([
    postArcGis(countyService, {
      where: `COUNTY_NAM='${escapeSql(countyUpper)}' OR COUNTY_NAM='${escapeSql(
        countyUpper[0] + countyUpper.slice(1).toLowerCase(),
      )}'`,
      outFields: 'COUNTY_NAM',
      returnGeometry: 'true',
      outSR: '4326',
      f: 'geojson',
    }),
    postArcGis(municipalityService, {
      where: municipalityWhere,
      outFields: 'DISTRICTNA,MUNID',
      returnGeometry: 'true',
      outSR: '4326',
      f: 'geojson',
    }),
  ]);

  const countyFeature = countyData.features?.[0];
  if (!countyFeature?.geometry) {
    throw new Error('County boundary was not returned by the Illinois DNR service');
  }

  const points = allPoints(countyFeature.geometry);
  if (!points.length) {
    throw new Error('County boundary contains no drawable points');
  }

  const xs = points.map((p) => p[0]);
  const ys = points.map((p) => p[1]);
  const minX = Math.min(...xs);
  const maxX = Math.max(...xs);
  const minY = Math.min(...ys);
  const maxY = Math.max(...ys);

  const width = 1000;
  const svgHeight = 700;
  const pad = 32;
  const sx = (width - pad * 2) / (maxX - minX);
  const sy = (svgHeight - pad * 2) / (maxY - minY);
  const scale = Math.min(sx, sy);
  const offsetX = (width - (maxX - minX) * scale) / 2;
  const offsetY = (svgHeight - (maxY - minY) * scale) / 2;

  const project = ([x, y]: number[]) => [
    offsetX + (x - minX) * scale,
    svgHeight - (offsetY + (y - minY) * scale),
  ];

  const pathFor = (geometry: any) =>
    ringsFromGeometry(geometry)
      .map(
        (ring) =>
          ring
            .map((point, index) => {
              const [x, y] = project(point);
              return `${index === 0 ? 'M' : 'L'}${x.toFixed(2)},${y.toFixed(2)}`;
            })
            .join(' ') + ' Z',
      )
      .join(' ');

  countyPath = pathFor(countyFeature.geometry);

  const byName = new Map(
    clientMunicipalities.map((item: any) => [item.name.toLowerCase(), item]),
  );

  municipalityShapes = (municipalityData.features ?? [])
    .map((feature: any) => {
      const featureName = String(feature.properties?.DISTRICTNA ?? '').trim();
      const item: any = byName.get(featureName.toLowerCase());
      if (!item || !feature.geometry) return null;

      return {
        name: item.name,
        href: item.href,
        className: `jurisdiction_municipality jurisdiction_municipality_${item.status}${
          item.crossCounty ? ' jurisdiction_municipality_cross_county' : ''
        }`,
        title: `${item.name}${item.crossCounty ? ' · crosses county line' : ''} · ${
          item.status === 'documented' || item.status === 'partial'
            ? 'research available'
            : 'research needed'
        }`,
        path: pathFor(feature.geometry),
      };
    })
    .filter(Boolean);
} catch (error) {
  mapError =
    error instanceof Error
      ? error.message
      : 'The Illinois DNR boundary service could not be reached during the site build.';
  console.warn(`[NoRec map] ${countyName} County: ${mapError}`);
}
---

{
  countyPath ? (
    <div
      class="jurisdiction_map jurisdiction_map_loaded"
      id={mapId}
      style={`--jurisdiction-map-height:${height}px`}
    >
      <div class="polygon_loader" aria-hidden="true">
        <span class="polygon_loader_spinner"></span>
        <span>Preparing boundary map</span>
      </div>
      <div class="jurisdiction_map_status">
        {countyName} County · click a municipal boundary to open its dossier
      </div>

      <svg
        class="jurisdiction_map_svg"
        viewBox="0 0 1000 700"
        role="img"
        aria-label={`${countyName} County municipal boundary map`}
      >
        <defs>
          <clipPath id={clipId}>
            <path d={countyPath} fill-rule="evenodd" />
          </clipPath>
        </defs>

        <path
          d={countyPath}
          class="jurisdiction_county_fill"
          fill-rule="evenodd"
        />

        {
          municipalityShapes.map((shape) => (
            <a href={shape.href} aria-label={shape.title}>
              <path
                d={shape.path}
                clip-path={`url(#${clipId})`}
                fill-rule="evenodd"
                class={shape.className}
              >
                <title>{shape.title}</title>
              </path>
            </a>
          ))
        }

        <path
          d={countyPath}
          class="jurisdiction_county_outline"
          fill-rule="evenodd"
        />
      </svg>
    </div>
  ) : (
    <div class="jurisdiction_map jurisdiction_map_error" id={mapId}>
      <div class="jurisdiction_map_status jurisdiction_map_status_error">
        Boundary map unavailable for this build. Use the municipality directory below.
      </div>
    </div>
  )
}

<script>
  const revealJurisdictionMaps = () => {
    document.querySelectorAll('.jurisdiction_map_loaded').forEach((map) => {
      requestAnimationFrame(() => map.classList.add('polygon_ready'));
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', revealJurisdictionMaps, { once: true });
  } else {
    revealJurisdictionMaps();
  }
</script>
