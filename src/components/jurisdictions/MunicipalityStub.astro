---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicRecords from './PublicRecords.astro';
import MunicipalityBoundaryMap from './MunicipalityBoundaryMap.astro';

const {
  name,
  form,
  county = 'Boone',
  counties: countiesProp,
  status = 'unresearched',
  records = [],
} = Astro.props;

const counties = Array.isArray(countiesProp)
  ? countiesProp
  : typeof countiesProp === 'string'
    ? countiesProp
        .replace(/^\s*\[/, '')
        .replace(/\]\s*$/, '')
        .split(',')
        .map((value) => value.trim().replace(/^['"]|['"]$/g, ''))
        .filter(Boolean)
    : [county];

const crossCounty = counties.length > 1;
const formLabel = `${form.charAt(0).toUpperCase()}${form.slice(1)}`;
---
<BaseLayout
  title={`${name} Surveillance | NoRec.US`}
  description={`Community surveillance research for ${name}, Illinois.`}
  active="surveillance"
>
  <main class="page_shell">
    <nav class="jurisdiction_breadcrumbs" aria-label="Breadcrumb">
      <a href="/illinois/">Illinois</a><span>→</span>
      <a href={`/illinois/counties/${county.toLowerCase().replace(/[^a-z0-9]+/g, '-')}/`}>{county} County</a><span>→</span>
      <strong>{name}</strong>
    </nav>

    <header class="article_header">
      <p class="eyebrow">LOCAL SURVEILLANCE · {name.toUpperCase()}, ILLINOIS</p>
      <h1>{name}</h1>
      <p class="article_deck">{formLabel} surveillance research. Unknown or undocumented categories should not be interpreted as evidence that surveillance technology is absent.</p>
    </header>

    <MunicipalityBoundaryMap name={name} county={county} />

    {crossCounty && (
      <section class="evidence_box evidence_unknown">
        <span class="status_label">CROSS-COUNTY MUNICIPALITY</span>
        <p><strong>{name}</strong> crosses {counties.join(' and ')} counties. It appears in this county directory because part of its incorporated boundary lies in {county} County. Municipal findings apply to the municipality as a whole unless a source says otherwise.</p>
      </section>
    )}

    <section class="evidence_box">
      <span class="status_label">{status.toUpperCase()}</span>
      <h2>Research needed.</h2>
      <p>NoRec.US has not yet reviewed enough primary records to publish surveillance findings for {name}. This blank dossier is a research placeholder, not a finding that the municipality uses no surveillance technology.</p>
      <p>Useful contributions include contracts, procurement records, policies, council packets, FOIA responses, audits, technology inventories, camera or ALPR records, drone reports, and other primary government records.</p>
      <a class="button button_dark" href="https://github.com/yung-megafone/NoRec-US">Contribute on GitHub</a>
    </section>

    <PublicRecords records={records} />
  </main>
</BaseLayout>
