---
import '../styles/global.css';
import RelatedEvidenceForPath from '../components/evidence/RelatedEvidenceForPath.astro';

const {
  title = 'NoRec.US',
  description = 'Government surveillance, documented from the source.',
  active = 'home',
  noindex = false,
  canonical
} = Astro.props;

const nav = [
  ['home', '/', 'Home'],
  ['surveillance', '/surveillance/', 'Surveillance'],
  ['map', '/illinois/', 'Map'],
  ['sources', '/sources/', 'Sources'],
  ['research', '/research/', 'Research'],
  ['tools', '/tools/', 'Tools'],
  ['privacy', '/why-privacy-matters/', 'IDC?'],
  ['about', '/about/', 'About']
];

const pathname = Astro.url.pathname;
const inferredActive =
  pathname === '/'
    ? 'home'
    : pathname.startsWith('/illinois/')
      ? 'map'
      : pathname.startsWith('/surveillance/')
        ? 'surveillance'
        : pathname.startsWith('/sources/')
          ? 'sources'
          : pathname.startsWith('/research/')
            ? 'research'
            : pathname.startsWith('/tools/')
              ? 'tools'
              : pathname.startsWith('/why-privacy-matters/')
                ? 'privacy'
                : pathname.startsWith('/about/')
                  ? 'about'
                  : active;
const currentNav = inferredActive || active;

const canonicalUrl =
  canonical ??
  new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();

const robots = noindex
  ? 'noindex, nofollow, noarchive'
  : 'index, follow';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="referrer" content="no-referrer" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#000000" />
    <link rel="shortcut icon" href="/favicon.ico?v=3" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=3" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png?v=3" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />
    <link rel="manifest" href="/site.webmanifest?v=3" />
    <link rel="stylesheet" href="/style/nav-selected-hotfix.css?v=1" />

    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NoRec.US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL("/brand/norec-wordmark.png", Astro.site ?? Astro.url.origin).toString()} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/brand/norec-wordmark.png", Astro.site ?? Astro.url.origin).toString()} />

    <title>{title}</title>
    <script>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <div class="site_loader" id="site_loader" aria-hidden="true">
      <div class="site_loader_inner">
        <img src="/brand/norec-icon-dark.png" alt="" width="52" height="52" />
        <div class="site_loader_track"><span></span></div>
        <span class="site_loader_text">Loading NoRec.US</span>
      </div>
    </div>

    <a class="skip_link" href="#site_content">Skip to content</a>

    <div id="main">
      <header id="header">
        <div id="logo">
          <div id="logo_text">
            <a href="/" class="site_brand" aria-label="NoRec.US — Surveillance, documented.">
              <img
                src="/brand/norec-wordmark-dark.png"
                alt="NoRec.US — Surveillance, documented."
                width="1086"
                height="362"
              />
            </a>
          </div>
        </div>

        <nav id="menubar" aria-label="Primary navigation">
          <input
            class="nav_toggle_state"
            id="nav_toggle_state"
            type="checkbox"
            aria-label="Toggle primary navigation"
          />
          <label class="nav_toggle" for="nav_toggle_state">
            <span>Menu</span>
            <span class="nav_toggle_icon" aria-hidden="true"><i></i><i></i><i></i></span>
          </label>
          <ul id="menu">
            {nav.map(([key, href, label]) => (
              key === 'surveillance' ? (
                <li class:list={[currentNav === key && 'selected', 'nav_has_submenu']}>
                  <details class="nav_submenu_details">
                    <summary class="nav_submenu_toggle">
                      <span>{label}</span>
                      <span class="nav_submenu_caret" aria-hidden="true">▾</span>
                    </summary>
                    <ul class="nav_submenu" id="surveillance_submenu">
                      <li><a href="/surveillance/">Surveillance overview</a></li>
                      <li><a href="/surveillance/evidence/">Evidence library</a></li>
                      <li><a href="/illinois/">Illinois jurisdictions + map</a></li>
                      <li><a href="/sources/">Sources + receipts</a></li>
                      <li class="nav_submenu_divider"><span>Evidence by category</span></li>
                      <li><a href="/surveillance/evidence/government/">Government</a></li>
                      <li><a href="/surveillance/evidence/workplace/">Workplace</a></li>
                      <li><a href="/surveillance/evidence/consumer/">Consumer / retail</a></li>
                      <li><a href="/surveillance/evidence/private/">Private / residential</a></li>
                      <li><a href="/surveillance/evidence/students/">Students / schools</a></li>
                      <li><a href="/surveillance/evidence/health/">Health / reproductive</a></li>
                      <li><a href="/surveillance/evidence/biometrics/">Biometrics</a></li>
                      <li><a href="/surveillance/evidence/aerial/">Aerial / drones</a></li>
                      <li><a href="/surveillance/evidence/infrastructure/">Data brokers / infrastructure</a></li>
                    </ul>
                  </details>
                </li>
              ) : key === 'tools' ? (
                <li class:list={[currentNav === key && 'selected', 'nav_has_submenu']}>
                  <details class="nav_submenu_details">
                    <summary class="nav_submenu_toggle">
                      <span>{label}</span><span class="nav_submenu_caret" aria-hidden="true">▾</span>
                    </summary>
                    <ul class="nav_submenu" id="tools_submenu">
                      <li><a href="/tools/">Tools overview</a></li>
                      <li><a href="/tools/redact/">Image Redactor</a></li>
                    </ul>
                  </details>
                </li>
              ) : (
                <li class={currentNav === key ? 'selected' : ''}>
                  <a href={href} aria-current={currentNav === key ? 'page' : undefined}>{label}</a>
                </li>
              )
            ))}
            <li class="nav_github">
              <a
                href="https://github.com/yung-megafone/NoRec-US"
                rel="external"
                aria-label="NoRec.US on GitHub"
                title="GitHub"
              >
                <img
                  src="/brand/social/github-alt.svg"
                  alt=""
                  width="22"
                  height="22"
                  aria-hidden="true"
                />
              </a>
            </li>
          </ul>
        </nav>
      </header>

      <main id="site_content" tabindex="-1">
        <slot />
        <RelatedEvidenceForPath pathname={pathname} />
      </main>

      <footer id="footer">
        <p class="footer_brandline">
          <img src="/brand/norec-icon-dark.png" alt="" width="28" height="28" aria-hidden="true" />
          <span>NoRec.US · Surveillance, documented.</span>
        </p>
        <p>
          NoRec.US original material · MIT License · <a href="/privacy/">Privacy Notice</a> ·
          Design inspiration: black_white · <a href="https://github.com/yung-megafone/NoRec-US">GitHub</a>
        </p>
      </footer>
    </div>

    <script>
      (() => {
        const root = document.documentElement;
        const loader = document.getElementById('site_loader');
        const navState = document.getElementById('nav_toggle_state');
        const menu = document.getElementById('menu');
        const submenuDetails = menu ? Array.from(menu.querySelectorAll('.nav_submenu_details')) : [];

        const hideLoader = () => {
          root.classList.add('site_ready');
          loader?.setAttribute('aria-hidden', 'true');
        };

        const showLoader = () => {
          root.classList.remove('site_ready');
          loader?.setAttribute('aria-hidden', 'false');
        };

        if (document.readyState === 'complete') {
          requestAnimationFrame(hideLoader);
        } else {
          window.addEventListener('load', () => requestAnimationFrame(hideLoader), { once: true });
        }

        window.addEventListener('pageshow', hideLoader);
        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const link = target.closest('a[href]');
          if (!link) return;
          if (
            event.defaultPrevented ||
            (event instanceof MouseEvent && event.button !== 0) ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
          ) return;
          if (link.target === '_blank' || link.hasAttribute('download')) return;
          const url = new URL(link.href, window.location.href);
          if (url.origin !== window.location.origin) return;
          if (url.pathname === window.location.pathname && url.search === window.location.search && url.hash) return;

          showLoader();
        });

        const closeNavigation = () => {
          if (navState instanceof HTMLInputElement) navState.checked = false;
          for (const details of submenuDetails) if (details instanceof HTMLDetailsElement) details.open = false;
        };

        menu?.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          if (target.closest('a[href]')) closeNavigation();
        });

        document.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape') return;
          closeNavigation();
          const label = document.querySelector('label[for="nav_toggle_state"]');
          if (label instanceof HTMLElement) label.focus();
        });

        window.addEventListener('resize', () => {
          if (window.innerWidth > 760) closeNavigation();
        });
      })();
    </script>
  </body>
</html>
