---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Brand Assets | NoRec.US"
  description="NoRec.US basic brand assets."
  active=""
  noindex={true}
>
<main class="page_shell">
  <header class="article_header">
    <p class="eyebrow">BRAND</p>
    <h1>Basic brand assets</h1>
    <p class="article_deck">NoRec.US marks for the website, favicon, social previews, and print use.</p>
  </header>

  <section>
    <p class="eyebrow">ASSETS</p>
    <h2>Transparent marks</h2>
    <div class="brand_asset_grid">
      <figure>
        <div class="brand_preview brand_preview_light">
          <img src="/brand/norec-icon-transparent.png" alt="NoRec.US square icon" />
        </div>
        <figcaption><a href="/brand/norec-icon-transparent.png">Square icon · transparent PNG</a></figcaption>
      </figure>
      <figure>
        <div class="brand_preview brand_preview_light brand_preview_wide">
          <img src="/brand/norec-wordmark-transparent.png" alt="NoRec.US wordmark" />
        </div>
        <figcaption><a href="/brand/norec-wordmark-transparent.png">Wordmark · transparent PNG</a></figcaption>
      </figure>
      <figure>
        <div class="brand_preview brand_preview_dark">
          <img src="/brand/norec-icon-dark.png" alt="NoRec.US icon for dark backgrounds" />
        </div>
        <figcaption><a href="/brand/norec-icon-dark.png">Dark-background icon · transparent PNG</a></figcaption>
      </figure>
      <figure>
        <div class="brand_preview brand_preview_dark brand_preview_wide">
          <img src="/brand/norec-wordmark-dark.png" alt="NoRec.US wordmark for dark backgrounds" />
        </div>
        <figcaption><a href="/brand/norec-wordmark-dark.png">Dark-background wordmark · transparent PNG</a></figcaption>
      </figure>
    </div>
    <ul class="provider_source_list">
      <li><a href="/favicon.ico">Favicon ICO</a></li>
      <li><a href="/favicon.png">Favicon PNG</a></li>
      <li><a href="/apple-touch-icon.png">Apple touch icon</a></li>
    </ul>
  </section>

  <section class="evidence_box">
    <span class="status_label">USE</span>
    <p>The square mark is used for favicons and compact applications. The wide wordmark is used in the site header and social-preview metadata.</p>
  </section>
</main>
</BaseLayout>
