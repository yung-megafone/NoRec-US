---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import MunicipalityBoundaryMap from '../../../../../../components/jurisdictions/MunicipalityBoundaryMap.astro';
import PublicRecords from '../../../../../../components/jurisdictions/PublicRecords.astro';
import { chicagoFindings } from '../../../../../../data/illinois/counties/cook';
import { chicagoRecords } from '../../../../../../data/illinois/counties/cook-records';
---
<BaseLayout title="Chicago Surveillance | NoRec.US" description="Publicly documented surveillance technology and records for Chicago, Illinois." active="surveillance">
<main class="page_shell">
<nav class="jurisdiction_breadcrumbs" aria-label="Breadcrumb"><a href="/illinois/">Illinois</a><span>→</span><a href="/illinois/counties/cook/">Cook County</a><span>→</span><strong>Chicago</strong></nav>
<header class="article_header">
  <p class="eyebrow">LOCAL SURVEILLANCE · CHICAGO, ILLINOIS</p>
  <h1>Chicago</h1>
  <p class="article_deck">Current CPD directives document body-worn cameras, automated license-plate readers, in-car video and helicopter video systems; current oversight records also document continued Police Observation Device camera deployments.</p>
</header>
<MunicipalityBoundaryMap name="Chicago" county="Cook" />
<section>
  <p class="eyebrow">DOCUMENTED SYSTEMS</p>
  <h2>Current and historical surveillance findings.</h2>
  <div class="finding_grid">
    {chicagoFindings.map(f => (
      <article>
        <span class="status_label">{f.status.toUpperCase()}</span>
        <p class="eyebrow finding_technology">{f.technology}</p>
        <h3>{f.title}</h3>
        <p>{f.summary}</p>
      </article>
    ))}
  </div>
</section>
<PublicRecords records={chicagoRecords} />
<section>
  <p class="eyebrow">UNRESOLVED</p>
  <h2>What still needs primary records.</h2>
  <ul class="about_questions">
    <li>Current device inventories, vendors, contracts, locations, policies, retention, sharing, access controls, and audit logs for documented systems.</li>
    <li>Any additional ALPR, UAS, fixed-camera, facial-recognition, social-media analytics, real-time crime center, in-car video, or investigative-software systems not yet represented here.</li>
  </ul>
</section>
</main>
</BaseLayout>