---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import MunicipalityBoundaryMap from '../../../../../../components/jurisdictions/MunicipalityBoundaryMap.astro';
import PublicRecords from '../../../../../../components/jurisdictions/PublicRecords.astro';
import { evanstonFindings } from '../../../../../../data/illinois/counties/cook';
import { evanstonRecords } from '../../../../../../data/illinois/counties/cook-records';
---
<BaseLayout title="Evanston Surveillance | NoRec.US" description="Publicly documented surveillance technology and records for Evanston, Illinois." active="surveillance">
<main class="page_shell">
<nav class="jurisdiction_breadcrumbs" aria-label="Breadcrumb"><a href="/illinois/">Illinois</a><span>→</span><a href="/illinois/counties/cook/">Cook County</a><span>→</span><strong>Evanston</strong></nav>
<header class="article_header">
  <p class="eyebrow">LOCAL SURVEILLANCE · EVANSTON, ILLINOIS</p>
  <h1>Evanston</h1>
  <p class="article_deck">Evanston has a documented Flock Safety ALPR/camera relationship dating to 2022 and a five-year contract proposal approved through the 2024 municipal process. Current device-level configuration remains a records target.</p>
</header>
<MunicipalityBoundaryMap name="Evanston" county="Cook" />
<section>
  <p class="eyebrow">DOCUMENTED SYSTEMS</p>
  <h2>Current and historical surveillance findings.</h2>
  <div class="finding_grid">
    {evanstonFindings.map(f => (
      <article>
        <span class="status_label">{f.status.toUpperCase()}</span>
        <p class="eyebrow finding_technology">{f.technology}</p>
        <h3>{f.title}</h3>
        <p>{f.summary}</p>
      </article>
    ))}
  </div>
</section>
<PublicRecords records={evanstonRecords} />
<section>
  <p class="eyebrow">UNRESOLVED</p>
  <h2>What still needs primary records.</h2>
  <ul class="about_questions">
    <li>Current device inventories, vendors, contracts, locations, policies, retention, sharing, access controls, and audit logs for documented systems.</li>
    <li>Any additional ALPR, UAS, fixed-camera, facial-recognition, social-media analytics, real-time crime center, in-car video, or investigative-software systems not yet represented here.</li>
  </ul>
</section>
</main>
</BaseLayout>