---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import MunicipalityBoundaryMap from '../../../../../../components/jurisdictions/MunicipalityBoundaryMap.astro';
import PublicRecords from '../../../../../../components/jurisdictions/PublicRecords.astro';
import DeploymentStatusMeta from '../../../../../../components/jurisdictions/DeploymentStatusMeta.astro';
import { mountProspectFindings } from '../../../../../../data/illinois/counties/cook';
import { mountProspectRecords } from '../../../../../../data/illinois/counties/cook-records';
---
<BaseLayout title="Mount Prospect Surveillance | NoRec.US" description="Source-backed surveillance research for Mount Prospect, Illinois." active="surveillance">
<main class="page_shell">
<nav class="jurisdiction_breadcrumbs" aria-label="Breadcrumb"><a href="/illinois/">Illinois</a><span>→</span><a href="/illinois/counties/cook/">Cook County</a><span>→</span><strong>Mount Prospect</strong></nav>
<header class="article_header"><p class="eyebrow">LOCAL SURVEILLANCE · MOUNT PROSPECT, ILLINOIS</p><h1>Mount Prospect</h1><p class="article_deck">Current findings are attributed to the agency named in the source. Operational state is shown separately from evidence quality so an investigation, pause, or sharing change does not erase the underlying deployment record.</p></header>
<MunicipalityBoundaryMap name="Mount Prospect" county="Cook" />
<section><p class="eyebrow">DOCUMENTED SYSTEMS</p><h2>Current and date-scoped findings.</h2><div class="finding_grid">{mountProspectFindings.map(f => (<article><span class="status_label">{(f.evidenceStatus ?? f.status).toUpperCase()}</span><DeploymentStatusMeta evidenceStatus={f.evidenceStatus} operationalStatus={f.operationalStatus} verifiedAsOf={f.verifiedAsOf} statusChangedOn={f.statusChangedOn} sourceAsOf={f.sourceAsOf} owner={f.owner} /><p class="eyebrow finding_technology">{f.technology}</p><h3>{f.title}</h3><p>{f.summary}</p></article>))}</div></section>
<PublicRecords records={mountProspectRecords} />
<section><p class="eyebrow">UNRESOLVED</p><h2>What still needs primary records.</h2><ul class="about_questions"><li>Current device inventory, exact locations, retention, sharing, authorized-user counts, and audit results where the cited record does not establish them.</li><li>Any additional surveillance systems not yet represented in the published source set.</li></ul></section>
</main></BaseLayout>
