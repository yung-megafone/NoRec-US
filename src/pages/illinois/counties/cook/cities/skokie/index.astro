---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import MunicipalityBoundaryMap from '../../../../../../components/jurisdictions/MunicipalityBoundaryMap.astro';
import PublicRecords from '../../../../../../components/jurisdictions/PublicRecords.astro';
import { skokieFindings } from '../../../../../../data/illinois/counties/cook';
import { skokieRecords } from '../../../../../../data/illinois/counties/cook-records';
---
<BaseLayout title="Skokie Surveillance | NoRec.US" description="Publicly documented surveillance technology and records for Skokie, Illinois." active="surveillance">
<main class="page_shell">
<nav class="jurisdiction_breadcrumbs" aria-label="Breadcrumb"><a href="/illinois/">Illinois</a><span>→</span><a href="/illinois/counties/cook/">Cook County</a><span>→</span><strong>Skokie</strong></nav>
<header class="article_header">
  <p class="eyebrow">LOCAL SURVEILLANCE · SKOKIE, ILLINOIS</p>
  <h1>Skokie</h1>
  <p class="article_deck">Skokie publishes unusually detailed current ALPR information, including a September 2026 inventory spanning Flock, Axon Fleet, Vigilant and Alltech systems, plus state documentation of its Axon body-camera deployment.</p>
</header>
<MunicipalityBoundaryMap name="Skokie" county="Cook" />
<section>
  <p class="eyebrow">DOCUMENTED SYSTEMS</p>
  <h2>Current and historical surveillance findings.</h2>
  <div class="finding_grid">
    {skokieFindings.map(f => (
      <article>
        <span class="status_label">{f.status.toUpperCase()}</span>
        <p class="eyebrow finding_technology">{f.technology}</p>
        <h3>{f.title}</h3>
        <p>{f.summary}</p>
      </article>
    ))}
  </div>
</section>
<PublicRecords records={skokieRecords} />
<section>
  <p class="eyebrow">UNRESOLVED</p>
  <h2>What still needs primary records.</h2>
  <ul class="about_questions">
    <li>Current device inventories, vendors, contracts, locations, policies, retention, sharing, access controls, and audit logs for documented systems.</li>
    <li>Any additional ALPR, UAS, fixed-camera, facial-recognition, social-media analytics, real-time crime center, in-car video, or investigative-software systems not yet represented here.</li>
  </ul>
</section>
</main>
</BaseLayout>