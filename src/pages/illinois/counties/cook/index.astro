---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CountyMunicipalityMap from '../../../../components/jurisdictions/CountyMunicipalityMap.astro';
import PublicRecords from '../../../../components/jurisdictions/PublicRecords.astro';
import DeploymentStatusMeta from '../../../../components/jurisdictions/DeploymentStatusMeta.astro';
import { cookMunicipalities, cookCountyFindings, cookMunicipalitySources } from '../../../../data/illinois/counties/cook';
import { cookCountyRecords } from '../../../../data/illinois/counties/cook-records';
---
<BaseLayout title="Cook County Surveillance | NoRec.US" description="County and municipal surveillance research for Cook County, Illinois." active="surveillance">
<main class="page_shell">
<nav class="jurisdiction_breadcrumbs" aria-label="Breadcrumb"><a href="/illinois/">Illinois</a><span>→</span><strong>Cook County</strong></nav>
<header class="article_header">
  <p class="eyebrow">LOCAL SURVEILLANCE · COOK COUNTY, ILLINOIS</p>
  <h1>Cook County</h1>
  <p class="article_deck">Cook County contains 134 municipalities, making this the largest municipal batch in the Illinois directory. Initial primary-record research documents Sheriff drones and GPS electronic monitoring, while Chicago, Skokie, Evanston, and Oak Park receive separate surveillance findings. The remaining municipality pages are explicit research queues rather than claims of no surveillance.</p>
</header>

<section>
  <p class="eyebrow">MUNICIPALITIES · OFFICIAL BOUNDARIES</p>
  <h2>134 municipal jurisdictions.</h2>
  <p>Cook County’s current government profile states that the county contains 134 municipalities. The Illinois State Archives local-government index is used to cross-check municipal names and forms.</p>
  <div class="map_legend" aria-label="Municipality map legend">
    <span><i class="legend_swatch legend_covered"></i><strong>Research available</strong></span>
    <span><i class="legend_swatch legend_open"></i><strong>Unresearched</strong></span>
  </div>
  <CountyMunicipalityMap county="Cook" municipalities={cookMunicipalities} />
  <div class="jurisdiction_cards municipality_directory">
    {cookMunicipalities.map(m => (
      <a href={`/illinois/counties/cook/cities/${m.slug}/`}>
        <strong>{m.name}</strong>
        <span>{m.form.charAt(0).toUpperCase()+m.form.slice(1)} · {m.status === 'documented' || m.status === 'partial' ? 'Municipal information available' : 'Research needed'}</span>
      </a>
    ))}
  </div>
  <p class="map_note"><a href={cookMunicipalitySources.countyProfile}>Cook County profile</a> · <a href={cookMunicipalitySources.municipalities}>Illinois State Archives local-government index</a></p>
</section>

<section>
  <p class="eyebrow">COUNTY SYSTEMS</p>
  <h2>Cook County Sheriff surveillance and monitoring.</h2>
  <div class="finding_grid">
    {cookCountyFindings.map(f => (
      <article>
        <span class="status_label">{(f.evidenceStatus ?? f.status).toUpperCase()}</span><DeploymentStatusMeta evidenceStatus={f.evidenceStatus} operationalStatus={f.operationalStatus} verifiedAsOf={f.verifiedAsOf} statusChangedOn={f.statusChangedOn} sourceAsOf={f.sourceAsOf} owner={f.owner} />
        <p class="eyebrow finding_technology">{f.technology}</p>
        <h3>{f.title}</h3>
        <p>{f.summary}</p>
      </article>
    ))}
  </div>
</section>

<PublicRecords records={cookCountyRecords} />

<section>
  <p class="eyebrow">NEXT RECORDS</p>
  <h2>This county is a research program by itself.</h2>
  <ul class="about_questions">
    <li>Cook County Sheriff current BWC/in-car-camera inventory, vendor, policy, retention, evidence platform, fixed-camera systems, ALPR access/use, and investigative software.</li>
    <li>Sheriff ASRT current aircraft inventory, make/models, payloads, flight logs, mutual-aid deployments, and retained UAS media.</li>
    <li>Chicago current ALPR vendor/device inventory, POD inventory and locations, in-car video, helicopter video, camera-network integrations, analytics, and data-sharing relationships.</li>
    <li>Municipality-by-municipality ALPR, BWC, UAS, fixed-camera, real-time crime center, facial-recognition, social-media analytics, and vendor-contract sweep across the remaining suburban agencies.</li>
  </ul>
</section>
</main>
</BaseLayout>
