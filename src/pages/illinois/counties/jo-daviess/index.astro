---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CountyMunicipalityMap from '../../../../components/jurisdictions/CountyMunicipalityMap.astro';
import PublicRecords from '../../../../components/jurisdictions/PublicRecords.astro';
import {
  joDaviessMunicipalities,
  joDaviessCountyFindings,
  joDaviessMunicipalitySources,
} from '../../../../data/illinois/counties/jo-daviess';
import { joDaviessCountyRecords } from '../../../../data/illinois/counties/jo-daviess-records';
---
<BaseLayout title="Jo Daviess County Surveillance | NoRec.US" description="County and municipal surveillance research for Jo Daviess County, Illinois." active="surveillance">
<main class="page_shell">
<nav class="jurisdiction_breadcrumbs" aria-label="Breadcrumb"><a href="/illinois/">Illinois</a><span>→</span><strong>Jo Daviess County</strong></nav>
<header class="article_header">
  <p class="eyebrow">LOCAL SURVEILLANCE · JO DAVIESS COUNTY, ILLINOIS</p>
  <h1>Jo Daviess County</h1>
  <p class="article_deck">Jo Daviess County has ten incorporated municipalities. Current and historical primary records document Sheriff body-worn cameras and a drone program; Galena has a current 2026 Axon body-camera and interview-room record.</p>
</header>

<section>
  <p class="eyebrow">MUNICIPALITIES · OFFICIAL BOUNDARIES</p>
  <h2>Drill down from Jo Daviess County to the municipality.</h2>
  <p>The Illinois State Archives identifies two cities and eight incorporated villages in Jo Daviess County. Unresearched municipality pages remain explicit unknowns rather than claims that surveillance is absent.</p>
  <div class="map_legend" aria-label="Municipality map legend">
    <span><i class="legend_swatch legend_covered"></i><strong>Research available</strong></span>
    <span><i class="legend_swatch legend_open"></i><strong>Unresearched</strong></span>
  </div>
  <CountyMunicipalityMap county="Jo Daviess" municipalities={joDaviessMunicipalities} />
  <div class="jurisdiction_cards municipality_directory">
    {joDaviessMunicipalities.map(m => (
      <a href={`/illinois/counties/jo-daviess/cities/${m.slug}/`}>
        <strong>{m.name}</strong>
        <span>{m.form.charAt(0).toUpperCase()+m.form.slice(1)} · {m.status === 'documented' || m.status === 'partial' ? 'Municipal information available' : 'Research needed'}</span>
      </a>
    ))}
  </div>
  <p class="map_note"><a href={joDaviessMunicipalitySources.municipalities}>Illinois State Archives municipality index</a></p>
</section>

<section>
  <p class="eyebrow">COUNTY SYSTEMS</p>
  <h2>Documented Sheriff surveillance systems.</h2>
  <div class="finding_grid">
    {joDaviessCountyFindings.map(f => (
      <article>
        <span class="status_label">{f.status.toUpperCase()}</span>
        <p class="eyebrow finding_technology">{f.technology}</p>
        <h3>{f.title}</h3>
        <p>{f.summary}</p>
      </article>
    ))}
  </div>
</section>

<PublicRecords records={joDaviessCountyRecords} />

<section>
  <p class="eyebrow">NEXT RECORDS</p>
  <h2>High-value follow-up.</h2>
  <ul class="about_questions">
    <li>Current Sheriff body-camera vendor, model, count, retention, evidence-storage platform, policy, and current activation/audit rules.</li>
    <li>Current Sheriff drone make/model, policy, flight logs since SFY2024, video retention, and whether the fleet remains one aircraft.</li>
    <li>Any Sheriff ALPR, fixed-camera, facial-recognition, social-media analytics, cell-site simulator, or other investigative-platform contracts and policies.</li>
    <li>Municipal police technology inventories for East Dubuque, Elizabeth, Hanover, Stockton, Warren, and Apple River.</li>
  </ul>
</section>
</main>
</BaseLayout>
