---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CountyMunicipalityMap from '../../../../components/jurisdictions/CountyMunicipalityMap.astro';
import PublicRecords from '../../../../components/jurisdictions/PublicRecords.astro';
import { kaneMunicipalities, kaneCountyFindings, kaneMunicipalitySource } from '../../../../data/illinois/counties/kane';
import { kaneCountyRecords } from '../../../../data/illinois/counties/kane-records';
---
<BaseLayout title="Kane County Surveillance | NoRec.US" description="County and municipal surveillance research for Kane County, Illinois." active="surveillance">
<main class="page_shell">
<nav class="jurisdiction_breadcrumbs" aria-label="Breadcrumb"><a href="/illinois/">Illinois</a><span>→</span><strong>Kane County</strong></nav>
<header class="article_header"><p class="eyebrow">LOCAL SURVEILLANCE · KANE COUNTY, ILLINOIS</p><h1>Kane County</h1><p class="article_deck">Kane County reports 30 municipalities wholly or partly within the county. Sheriff systems are kept separate from city and village systems, and cross-county municipalities link into the same broader municipal research model.</p></header>
<section><p class="eyebrow">MUNICIPALITIES · OFFICIAL COUNTY DIRECTORY</p><h2>Full Kane County municipal coverage.</h2><p>All 30 municipalities in the current Kane County directory now have routes. St. Charles and Elgin have Kane-specific primary-record findings; Huntley redirects to the existing McHenry-canonical dossier so the same municipality is not maintained twice.</p>
<div class="map_legend"><span><i class="legend_swatch legend_covered"></i><strong>Research available</strong></span><span><i class="legend_swatch legend_open"></i><strong>Unresearched</strong></span><span><i class="legend_swatch legend_cross_county"></i><strong>Crosses county line</strong></span></div>
<CountyMunicipalityMap county="Kane" municipalities={kaneMunicipalities} />
<div class="jurisdiction_cards municipality_directory">{kaneMunicipalities.map(m => (<a href={`/illinois/counties/kane/cities/${m.slug}/`}><strong>{m.name}</strong><span>{m.form.charAt(0).toUpperCase()+m.form.slice(1)} · {m.status === 'documented' || m.status === 'partial' ? 'Municipal dossier available' : 'Research needed'}{m.crossCounty ? ` · crosses ${m.counties.join(' / ')} counties` : ''}</span></a>))}</div>
<p class="map_note"><a href={kaneMunicipalitySource}>Official Kane County communities directory</a></p></section>
<section><p class="eyebrow">KANE COUNTY SHERIFF'S OFFICE</p><h2>County-level findings.</h2><div class="finding_grid">{kaneCountyFindings.map(f => (<article><span class="status_label">{f.status.toUpperCase()}</span><p class="eyebrow finding_technology">{f.technology}</p><h3>{f.title}</h3><p>{f.summary}</p></article>))}</div></section>
<PublicRecords records={kaneCountyRecords} />
<section><p class="eyebrow">RESEARCH GAPS</p><h2>High-value follow-up.</h2><ul class="about_questions"><li>Current Sheriff Flock inventory, exact installations, locations, retention, hot lists, sharing configuration, audits, and users.</li><li>Current Sheriff body-worn/in-car camera inventory and any UAS, facial-recognition, analytics, social-media, or other investigative platforms.</li><li>Municipal surveillance inventories for the cities and villages still marked unresearched.</li></ul></section>
</main></BaseLayout>
