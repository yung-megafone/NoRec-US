---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import PublicRecords from '../../../../../../components/jurisdictions/PublicRecords.astro';
import { yorkvilleFindings } from '../../../../../../data/illinois/counties/kendall';
import { yorkvilleRecords } from '../../../../../../data/illinois/counties/kendall-records';
---
<BaseLayout title="Yorkville Surveillance | NoRec.US" description="Publicly documented surveillance-related technology and primary records for Yorkville, Illinois." active="surveillance">
<main class="page_shell">
  <nav class="jurisdiction_breadcrumbs" aria-label="Breadcrumb">
    <a href="/illinois/">Illinois</a><span>→</span><a href="/illinois/counties/kendall/">Kendall County</a><span>→</span><strong>Yorkville</strong>
  </nav>

  <header class="article_header">
    <p class="eyebrow">LOCAL SURVEILLANCE · YORKVILLE, ILLINOIS</p>
    <h1>Yorkville</h1>
    <p class="article_deck">Municipal findings for the United City of Yorkville and Yorkville Police Department. County and KenCom systems remain separate unless a record attributes ownership or operation to Yorkville.</p>
  </header>

  <section>
    <p class="eyebrow">YORKVILLE POLICE DEPARTMENT</p>
    <h2>Documented surveillance systems.</h2>
    <div class="finding_grid">
      {yorkvilleFindings.map(finding => (
        <article>
          <span class="status_label">{finding.status.toUpperCase()}</span>
          <p class="eyebrow finding_technology">{finding.technology}</p>
          <h3>{finding.title}</h3>
          <p>{finding.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="evidence_box evidence_unknown">
    <span class="status_label">OWNERSHIP / SCOPE</span>
    <h2>Regional access is not the same thing as municipal ownership.</h2>
    <p>KenCom operates a shared Kendall County public-safety environment. NoRec only assigns equipment counts to Yorkville when a primary record attributes the device or subscription to the municipality or its police department. Regional camera counts and other agencies' devices are not copied into this city dossier.</p>
  </section>

  <PublicRecords records={yorkvilleRecords} />

  <section>
    <p class="eyebrow">UNRESOLVED</p>
    <h2>What still needs primary records.</h2>
    <ul class="about_questions">
      <li>Current Yorkville-owned ALPR camera count, camera IDs, locations, vendor contracts, retention, and sharing configuration.</li><li>Current drone inventory, models, serials, payloads, flight totals, annual reports, and retained recordings.</li><li>Current body-worn and in-car camera inventory, vendor, retention, and evidence-storage contracts.</li><li>Fixed-camera systems, social-media analytics, facial recognition, and other investigative software.</li>
    </ul>
  </section>
</main>
</BaseLayout>
