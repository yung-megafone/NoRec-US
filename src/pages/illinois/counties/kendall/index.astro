---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CountyMunicipalityMap from '../../../../components/jurisdictions/CountyMunicipalityMap.astro';
import PublicRecords from '../../../../components/jurisdictions/PublicRecords.astro';
import { kendallMunicipalities, kendallMunicipalitySources, kendallCountyFindings } from '../../../../data/illinois/counties/kendall';
import { kendallCountyRecords } from '../../../../data/illinois/counties/kendall-records';
---
<BaseLayout
  title="Kendall County Surveillance | NoRec.US"
  description="County and municipal surveillance research for Kendall County, Illinois, including KenCom Flock ALPR records, Sheriff UAS policy, municipal dossiers, and FOIA sources."
  active="surveillance"
>
<main class="page_shell">
  <nav class="jurisdiction_breadcrumbs" aria-label="Breadcrumb">
    <a href="/illinois/">Illinois</a><span>→</span><strong>Kendall County</strong>
  </nav>

  <header class="article_header">
    <p class="eyebrow">LOCAL SURVEILLANCE · KENDALL COUNTY, ILLINOIS</p>
    <h1>Kendall County</h1>
    <p class="article_deck">Kendall County records document a regional KenCom/Flock license-plate-reader project and a Sheriff UAS policy framework. Municipal systems are kept on their own pages so regional or county infrastructure is not automatically counted as equipment owned by a city or village.</p>
  </header>

  <section>
    <p class="eyebrow">MUNICIPALITIES · OFFICIAL BOUNDARIES</p>
    <h2>Drill down from Kendall County to the municipality.</h2>
    <p>Kendall County identifies 15 incorporated communities or municipal portions within the county. Several extend into neighboring counties, so NoRec tracks the geographic relationship without treating a county boundary as the ownership boundary for the municipality.</p>

    <div class="map_legend" aria-label="Municipality map legend">
      <span><i class="legend_swatch legend_covered"></i><strong>Research available</strong></span>
      <span><i class="legend_swatch legend_open"></i><strong>Unresearched</strong></span>
      <span><i class="legend_swatch legend_cross_county"></i><strong>Crosses county line</strong></span>
    </div>

    <CountyMunicipalityMap county="Kendall" municipalities={kendallMunicipalities} />

    <div class="jurisdiction_cards municipality_directory">
      {kendallMunicipalities.map(municipality => (
        <a href={`/illinois/counties/kendall/cities/${municipality.slug}/`}>
          <strong>{municipality.name}</strong>
          <span>{municipality.form.charAt(0).toUpperCase() + municipality.form.slice(1)} · {municipality.status === 'partial' || municipality.status === 'documented' ? 'Municipal dossier available' : 'Research needed'}{municipality.crossCounty ? ` · crosses ${municipality.counties.join(' / ')} counties` : ''}</span>
        </a>
      ))}
    </div>

    <p class="map_note">
      <a href={kendallMunicipalitySources.countyCommunities}>Kendall County municipality list</a> ·
      <a href={kendallMunicipalitySources.stateArchives}>Illinois State Archives index</a> ·
      <a href={kendallMunicipalitySources.countyGis}>Kendall County GIS municipality layer</a>
    </p>
  </section>

  <section>
    <p class="eyebrow">COUNTY / REGIONAL SYSTEMS</p>
    <h2>Documented surveillance infrastructure.</h2>
    <div class="finding_grid">
      {kendallCountyFindings.map(finding => (
        <article>
          <span class="status_label">{finding.status.toUpperCase()}</span>
          <p class="eyebrow finding_technology">{finding.technology}</p>
          <h3>{finding.title}</h3>
          <p>{finding.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="evidence_box evidence_unknown">
    <span class="status_label">CURRENT COUNT UNRESOLVED</span>
    <h2>Historical countywide LPR counts are not a 2026 inventory.</h2>
    <p>KenCom and municipal records establish a shared Flock deployment and show that ten cameras were in Kendall County during the 2022 Oswego board discussion. Plano records from 2025 also confirm multiple Kendall County agencies continued using Flock. NoRec has not yet obtained a current KenCom/Kendall-wide device inventory, current ownership matrix, installation coordinates, sharing configuration, or audit history, so those remain unresolved.</p>
  </section>

  <PublicRecords records={kendallCountyRecords} />

  <section>
    <p class="eyebrow">NEXT RECORDS</p>
    <h2>High-value follow-up.</h2>
    <ul class="about_questions">
      <li>Current KenCom/Kendall County Flock inventory by agency, camera ID, ownership, status, and installation location.</li>
      <li>Current KenCom ALPR MOU, system-monitoring policy, audit protocol, camera-placement policy, and camera-movement policy.</li>
      <li>Current Sheriff UAS inventory, aircraft make/model/serial, payloads, flight logs, annual reports, and retention practices.</li>
      <li>Current county and municipal ALPR sharing configuration, hotlists, search/audit logs, and retention settings.</li>
      <li>Body-worn/in-car camera, fixed-camera, facial-recognition, social-media analytics, and other investigative-system contracts and policies.</li>
    </ul>
  </section>
</main>
</BaseLayout>
