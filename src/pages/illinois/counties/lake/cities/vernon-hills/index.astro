---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import MunicipalityBoundaryMap from '../../../../../../components/jurisdictions/MunicipalityBoundaryMap.astro';
import PublicRecords from '../../../../../../components/jurisdictions/PublicRecords.astro';
import { vernonHillsFindings } from '../../../../../../data/illinois/counties/lake';
import { vernonHillsRecords } from '../../../../../../data/illinois/counties/lake-records';
---
<BaseLayout title="Vernon Hills Surveillance | NoRec.US" description="Publicly documented surveillance-related technology and records for Vernon Hills, Illinois." active="surveillance">
<main class="page_shell">
<nav class="jurisdiction_breadcrumbs" aria-label="Breadcrumb"><a href="/illinois/">Illinois</a><span>→</span><a href="/illinois/counties/lake/">Lake County</a><span>→</span><strong>Vernon Hills</strong></nav>
<header class="article_header"><p class="eyebrow">LOCAL SURVEILLANCE · VERNON HILLS, ILLINOIS</p><h1>Vernon Hills</h1><p class="article_deck">Findings on this page are attributed only to Vernon Hills or its Police Department when supported by the cited record. Lake County Sheriff and privately owned systems remain separate unless the source establishes municipal access or ownership.</p></header>
<MunicipalityBoundaryMap name="Vernon Hills" county="Lake" />
<section><p class="eyebrow">VERNON HILLS</p><h2>Documented surveillance systems.</h2><div class="finding_grid">{vernonHillsFindings.map(f => (<article><span class="status_label">{f.status.toUpperCase()}</span><p class="eyebrow finding_technology">{f.technology}</p><h3>{f.title}</h3><p>{f.summary}</p></article>))}</div></section>
<PublicRecords records={vernonHillsRecords} />
<section><p class="eyebrow">UNRESOLVED</p><h2>What still needs primary records.</h2><ul class="about_questions"><li>Current installed inventory and exact installation status where contract or historical counts are the newest available source.</li><li>Current locations, sharing configuration, audits, users, retention exceptions, and other surveillance technologies not yet documented.</li></ul></section>
</main></BaseLayout>