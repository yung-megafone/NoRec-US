---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CountyMunicipalityMap from '../../../../components/jurisdictions/CountyMunicipalityMap.astro';
import PublicRecords from '../../../../components/jurisdictions/PublicRecords.astro';
import DeploymentStatusMeta from '../../../../components/jurisdictions/DeploymentStatusMeta.astro';
import { lakeMunicipalities, lakeCountyFindings, lakeMunicipalitySource, lakeMunicipalityMapSource } from '../../../../data/illinois/counties/lake';
import { lakeCountyRecords } from '../../../../data/illinois/counties/lake-records';
---
<BaseLayout title="Lake County Surveillance | NoRec.US" description="County and municipal surveillance research for Lake County, Illinois." active="surveillance">
<main class="page_shell">
<nav class="jurisdiction_breadcrumbs" aria-label="Breadcrumb"><a href="/illinois/">Illinois</a><span>→</span><strong>Lake County</strong></nav>
<header class="article_header"><p class="eyebrow">LOCAL SURVEILLANCE · LAKE COUNTY, ILLINOIS</p><h1>Lake County</h1><p class="article_deck">Lake County reports 52 incorporated cities and villages. This batch scaffolds every one and keeps Sheriff, municipal, and privately owned systems separate unless a source establishes agency access or ownership.</p></header>
<section><p class="eyebrow">MUNICIPALITIES · OFFICIAL COUNTY DIRECTORY</p><h2>Full Lake County municipal coverage.</h2><p>Every incorporated city or village listed by Lake County now has a route. Seven currently have primary-record surveillance findings; the remainder are explicit research gaps, not claims of absence.</p>
<div class="map_legend" aria-label="Municipality map legend"><span><i class="legend_swatch legend_covered"></i><strong>Research available</strong></span><span><i class="legend_swatch legend_open"></i><strong>Unresearched</strong></span><span><i class="legend_swatch legend_cross_county"></i><strong>Crosses county line</strong></span></div>
<CountyMunicipalityMap county="Lake" municipalities={lakeMunicipalities} />
<div class="jurisdiction_cards municipality_directory">{lakeMunicipalities.map(m => (<a href={`/illinois/counties/lake/cities/${m.slug}/`}><strong>{m.name}</strong><span>{m.form.charAt(0).toUpperCase()+m.form.slice(1)} · {m.status === 'documented' || m.status === 'partial' ? 'Municipal dossier available' : 'Research needed'}{m.crossCounty ? ` · crosses ${m.counties.join(' / ')} counties` : ''}</span></a>))}</div>
<p class="map_note"><a href={lakeMunicipalitySource}>Official Lake County municipality directory</a> · <a href={lakeMunicipalityMapSource}>Official Lake County GIS city/village map</a></p></section>
<section><p class="eyebrow">LAKE COUNTY SHERIFF'S OFFICE</p><h2>County-level findings.</h2><div class="finding_grid">{lakeCountyFindings.map(f => (<article><span class="status_label">{(f.evidenceStatus ?? f.status).toUpperCase()}</span><DeploymentStatusMeta evidenceStatus={f.evidenceStatus} operationalStatus={f.operationalStatus} verifiedAsOf={f.verifiedAsOf} statusChangedOn={f.statusChangedOn} sourceAsOf={f.sourceAsOf} owner={f.owner} /><p class="eyebrow finding_technology">{f.technology}</p><h3>{f.title}</h3><p>{f.summary}</p></article>))}</div></section>
<PublicRecords records={lakeCountyRecords} />
<section><p class="eyebrow">RESEARCH GAPS</p><h2>High-value follow-up.</h2><ul class="about_questions"><li>Current Sheriff ALPR inventory, vendor, camera locations, retention, sharing, hot-list sources, and audit configuration.</li><li>Current Sheriff drone fleet and annual flight history beyond the published policy.</li><li>Municipal ALPR, UAS, CCTV, facial-recognition, analytics, and investigative-software inventories for unresearched municipalities.</li></ul></section>
</main></BaseLayout>
