---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CountyMunicipalityMap from '../../../../components/jurisdictions/CountyMunicipalityMap.astro';
import PublicRecords from '../../../../components/jurisdictions/PublicRecords.astro';
import DeploymentStatusMeta from '../../../../components/jurisdictions/DeploymentStatusMeta.astro';
import {
  stephensonMunicipalities,
  stephensonCountyFindings,
  stephensonMunicipalitySources,
} from '../../../../data/illinois/counties/stephenson';
import { stephensonCountyRecords } from '../../../../data/illinois/counties/stephenson-records';
---
<BaseLayout title="Stephenson County Surveillance | NoRec.US" description="County and municipal surveillance research for Stephenson County, Illinois." active="surveillance">
<main class="page_shell">
<nav class="jurisdiction_breadcrumbs" aria-label="Breadcrumb"><a href="/illinois/">Illinois</a><span>→</span><strong>Stephenson County</strong></nav>
<header class="article_header">
  <p class="eyebrow">LOCAL SURVEILLANCE · STEPHENSON COUNTY, ILLINOIS</p>
  <h1>Stephenson County</h1>
  <p class="article_deck">Stephenson County contains 11 incorporated municipalities. Current primary records document Sheriff body/squad video and extensive jail-camera infrastructure; Freeport has a separate municipal dossier covering ALPR, ShotSpotter, body cameras, fixed cameras, and tip411.</p>
</header>

<section>
  <p class="eyebrow">MUNICIPALITIES · OFFICIAL BOUNDARIES</p>
  <h2>Drill down from Stephenson County to the municipality.</h2>
  <p>Illinois State Archives and Stephenson County planning records identify one city and ten incorporated villages/towns. Unresearched municipality pages remain explicit unknowns rather than claims that surveillance is absent.</p>
  <div class="map_legend" aria-label="Municipality map legend">
    <span><i class="legend_swatch legend_covered"></i><strong>Research available</strong></span>
    <span><i class="legend_swatch legend_open"></i><strong>Unresearched</strong></span>
  </div>
  <CountyMunicipalityMap county="Stephenson" municipalities={stephensonMunicipalities} />
  <div class="jurisdiction_cards municipality_directory">
    {stephensonMunicipalities.map(m => (
      <a href={`/illinois/counties/stephenson/cities/${m.slug}/`}>
        <strong>{m.name}</strong>
        <span>{m.form.charAt(0).toUpperCase()+m.form.slice(1)} · {m.status === 'documented' || m.status === 'partial' ? 'Municipal dossier available' : 'Research needed'}</span>
      </a>
    ))}
  </div>
  <p class="map_note"><a href={stephensonMunicipalitySources.municipalities}>Illinois State Archives municipality index</a> · <a href={stephensonMunicipalitySources.mitigationPlan}>Stephenson County mitigation plan</a></p>
</section>

<section>
  <p class="eyebrow">COUNTY SYSTEMS</p>
  <h2>Documented Sheriff and corrections infrastructure.</h2>
  <div class="finding_grid">
    {stephensonCountyFindings.map(f => (
      <article>
        <span class="status_label">{(f.evidenceStatus ?? f.status).toUpperCase()}</span><DeploymentStatusMeta evidenceStatus={f.evidenceStatus} operationalStatus={f.operationalStatus} verifiedAsOf={f.verifiedAsOf} statusChangedOn={f.statusChangedOn} sourceAsOf={f.sourceAsOf} owner={f.owner} />
        <p class="eyebrow finding_technology">{f.technology}</p>
        <h3>{f.title}</h3>
        <p>{f.summary}</p>
      </article>
    ))}
  </div>
</section>

<PublicRecords records={stephensonCountyRecords} />

<section>
  <p class="eyebrow">NEXT RECORDS</p>
  <h2>High-value follow-up.</h2>
  <ul class="about_questions">
    <li>Current Sheriff body-worn and squad-camera vendor, models, inventory, retention, upload/storage platform, audit process, and policy.</li>
    <li>Any Sheriff ALPR, drone/UAS, fixed-camera, facial-recognition, social-media analytics, or other investigative-software contracts and policies.</li>
    <li>Current jail-camera inventory and retention rather than the site’s approximate “nearly one hundred” figure.</li>
    <li>Freeport’s current ALPR inventory, locations, vendor, retention/sharing settings, ShotSpotter status, and residential-doorbell pilot outcome.</li>
    <li>Lena Police and remaining municipal surveillance policies, contracts, inventories, and FOIA contacts.</li>
  </ul>
</section>
</main>
</BaseLayout>
