---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import MunicipalityBoundaryMap from '../../../../../../components/jurisdictions/MunicipalityBoundaryMap.astro';
import PublicRecords from '../../../../../../components/jurisdictions/PublicRecords.astro';
import { fultonFindings } from '../../../../../../data/illinois/counties/whiteside';
import { fultonRecords } from '../../../../../../data/illinois/counties/whiteside-records';
---
<BaseLayout title="Fulton Surveillance | NoRec.US" description="Publicly documented surveillance technology and records for Fulton, Illinois." active="surveillance">
<main class="page_shell">
<nav class="jurisdiction_breadcrumbs" aria-label="Breadcrumb"><a href="/illinois/">Illinois</a><span>→</span><a href="/illinois/counties/whiteside/">Whiteside County</a><span>→</span><strong>Fulton</strong></nav>
<header class="article_header">
  <p class="eyebrow">LOCAL SURVEILLANCE · FULTON, ILLINOIS</p>
  <h1>Fulton</h1>
  <p class="article_deck">A public-record index identifies a Fulton Police Flock Safety deployment in 2025. Because NoRec has not yet located the direct Fulton-origin contract or policy, the deployment remains partial pending primary records.</p>
</header>
<MunicipalityBoundaryMap name="Fulton" county="Whiteside" />
<section>
  <p class="eyebrow">FULTON</p>
  <h2>Documented surveillance systems.</h2>
  <div class="finding_grid">
    {fultonFindings.map(f => (
      <article>
        <span class="status_label">{f.status.toUpperCase()}</span>
        <p class="eyebrow finding_technology">{f.technology}</p>
        <h3>{f.title}</h3>
        <p>{f.summary}</p>
      </article>
    ))}
  </div>
</section>
<PublicRecords records={fultonRecords} />
<section>
  <p class="eyebrow">UNRESOLVED</p>
  <h2>What still needs primary records.</h2>
  <ul class="about_questions">
    <li>Current device counts, contracts, policies, retention, access controls, sharing, and audit logs for documented systems.</li>
    <li>Any additional ALPR, drone/UAS, fixed-camera, facial-recognition, social-media analytics, in-car video, or investigative-software use not yet represented here.</li>
  </ul>
</section>
</main>
</BaseLayout>