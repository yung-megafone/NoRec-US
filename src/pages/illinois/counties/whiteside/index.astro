---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CountyMunicipalityMap from '../../../../components/jurisdictions/CountyMunicipalityMap.astro';
import PublicRecords from '../../../../components/jurisdictions/PublicRecords.astro';
import DeploymentStatusMeta from '../../../../components/jurisdictions/DeploymentStatusMeta.astro';
import {
  whitesideMunicipalities,
  whitesideCountyFindings,
  whitesideMunicipalitySources,
} from '../../../../data/illinois/counties/whiteside';
import { whitesideCountyRecords } from '../../../../data/illinois/counties/whiteside-records';
---
<BaseLayout title="Whiteside County Surveillance | NoRec.US" description="County and municipal surveillance research for Whiteside County, Illinois." active="surveillance">
<main class="page_shell">
<nav class="jurisdiction_breadcrumbs" aria-label="Breadcrumb"><a href="/illinois/">Illinois</a><span>→</span><strong>Whiteside County</strong></nav>
<header class="article_header">
  <p class="eyebrow">LOCAL SURVEILLANCE · WHITESIDE COUNTY, ILLINOIS</p>
  <h1>Whiteside County</h1>
  <p class="article_deck">Whiteside County has eleven incorporated municipalities. Primary records document Sheriff body-worn cameras, an active sUAS/drone unit, and RapidSOS emergency-location infrastructure. Sterling and Rock Falls have substantial municipal camera records, with a partial Flock lead for Fulton.</p>
</header>

<section>
  <p class="eyebrow">MUNICIPALITIES · OFFICIAL BOUNDARIES</p>
  <h2>Drill down from Whiteside County to the municipality.</h2>
  <p>The Illinois State Archives and current County yearbook identify five cities and six villages. Unresearched pages remain explicit unknowns rather than claims that surveillance is absent.</p>
  <div class="map_legend" aria-label="Municipality map legend">
    <span><i class="legend_swatch legend_covered"></i><strong>Research available</strong></span>
    <span><i class="legend_swatch legend_open"></i><strong>Unresearched</strong></span>
  </div>
  <CountyMunicipalityMap county="Whiteside" municipalities={whitesideMunicipalities} />
  <div class="jurisdiction_cards municipality_directory">
    {whitesideMunicipalities.map(m => (
      <a href={`/illinois/counties/whiteside/cities/${m.slug}/`}>
        <strong>{m.name}</strong>
        <span>{m.form.charAt(0).toUpperCase()+m.form.slice(1)} · {m.status === 'documented' || m.status === 'partial' ? 'Municipal information available' : 'Research needed'}</span>
      </a>
    ))}
  </div>
  <p class="map_note"><a href={whitesideMunicipalitySources.municipalities}>Illinois State Archives municipality index</a> · <a href={whitesideMunicipalitySources.yearbook}>Whiteside County yearbook</a></p>
</section>

<section>
  <p class="eyebrow">COUNTY SYSTEMS</p>
  <h2>Documented Sheriff and emergency-communications systems.</h2>
  <div class="finding_grid">
    {whitesideCountyFindings.map(f => (
      <article>
        <span class="status_label">{(f.evidenceStatus ?? f.status).toUpperCase()}</span><DeploymentStatusMeta evidenceStatus={f.evidenceStatus} operationalStatus={f.operationalStatus} verifiedAsOf={f.verifiedAsOf} statusChangedOn={f.statusChangedOn} sourceAsOf={f.sourceAsOf} owner={f.owner} />
        <p class="eyebrow finding_technology">{f.technology}</p>
        <h3>{f.title}</h3>
        <p>{f.summary}</p>
      </article>
    ))}
  </div>
</section>

<PublicRecords records={whitesideCountyRecords} />

<section>
  <p class="eyebrow">NEXT RECORDS</p>
  <h2>High-value follow-up.</h2>
  <ul class="about_questions">
    <li>Current Sheriff BWC inventory/vendor, evidence platform, retention, policy, activation rules, and audit logs.</li>
    <li>Current Sheriff sUAS fleet count, make/models, flight logs, video retention, policies, and 2025–2026 equipment changes.</li>
    <li>Any Sheriff ALPR/Flock/Vigilant, facial-recognition, social-media analytics, fixed-camera, or other investigative-platform contracts and policies.</li>
    <li>Sterling Flock contract/current camera inventory, Axon BWC count and policy, Evidence configuration, and Avigilon camera inventory.</li>
    <li>Rock Falls Flock pilot contract/current inventory and current Axon BWC/in-car-camera systems.</li>
    <li>Direct Fulton-origin records for its reported Flock deployment, plus police technology inventories for the remaining municipalities.</li>
  </ul>
</section>
</main>
</BaseLayout>
