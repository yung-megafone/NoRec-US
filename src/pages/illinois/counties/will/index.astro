---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CountyMunicipalityMap from '../../../../components/jurisdictions/CountyMunicipalityMap.astro';
import PublicRecords from '../../../../components/jurisdictions/PublicRecords.astro';
import { willMunicipalities, willCountyFindings, willMunicipalitySource } from '../../../../data/illinois/counties/will';
import { willCountyRecords } from '../../../../data/illinois/counties/will-records';
---
<BaseLayout title="Will County Surveillance | NoRec.US" description="County and municipal surveillance research for Will County, Illinois." active="surveillance">
<main class="page_shell">
<nav class="jurisdiction_breadcrumbs"><a href="/illinois/">Illinois</a><span>→</span><strong>Will County</strong></nav>
<header class="article_header"><p class="eyebrow">LOCAL SURVEILLANCE · WILL COUNTY, ILLINOIS</p><h1>Will County</h1><p class="article_deck">Will County is now scaffolded across its incorporated municipalities and municipal portions. Sheriff systems remain separate from city and village systems, while cross-county municipalities are linked without duplicating factual datasets.</p></header>
<section><p class="eyebrow">MUNICIPALITIES</p><h2>Countywide municipal coverage.</h2><p>This directory covers 36 incorporated municipalities or municipal portions intersecting Will County. Joliet, Plainfield, and Romeoville have initial surveillance dossiers; unresearched entries mean records have not yet been reviewed, not that surveillance is absent.</p>
<div class="map_legend"><span><i class="legend_swatch legend_covered"></i><strong>Research available</strong></span><span><i class="legend_swatch legend_open"></i><strong>Unresearched</strong></span><span><i class="legend_swatch legend_cross_county"></i><strong>Crosses county line</strong></span></div>
<CountyMunicipalityMap county="Will" municipalities={willMunicipalities} />
<div class="jurisdiction_cards municipality_directory">{willMunicipalities.map(m => (<a href={`/illinois/counties/will/cities/${m.slug}/`}><strong>{m.name}</strong><span>{m.form.charAt(0).toUpperCase()+m.form.slice(1)} · {m.status === 'documented' || m.status === 'partial' ? 'Municipal dossier available' : 'Research needed'}{m.crossCounty ? ` · crosses ${m.counties.join(' / ')} counties` : ''}</span></a>))}</div>
<p class="map_note"><a href={willMunicipalitySource}>Will County official government source</a></p></section>
<section><p class="eyebrow">WILL COUNTY SHERIFF'S OFFICE</p><h2>County-level findings.</h2><div class="finding_grid">{willCountyFindings.map(f => (<article><span class="status_label">{f.status.toUpperCase()}</span><p class="eyebrow finding_technology">{f.technology}</p><h3>{f.title}</h3><p>{f.summary}</p></article>))}</div></section>
<PublicRecords records={willCountyRecords} />
<section><p class="eyebrow">RESEARCH GAPS</p><h2>High-value follow-up.</h2><ul class="about_questions"><li>Current Sheriff ALPR inventory, vendor, locations, retention, sharing, hot lists, audits, and users.</li><li>Current Sheriff UAS, fixed-camera, facial-recognition, analytics, social-media, and investigative-software inventories.</li><li>Municipal surveillance inventories for entries still marked unresearched.</li></ul></section>
</main></BaseLayout>
