---
import BaseLayout from '../../../../../../layouts/BaseLayout.astro';
import PublicRecords from '../../../../../../components/jurisdictions/PublicRecords.astro';
import { rockfordFindings } from '../../../../../../data/illinois/counties/winnebago';
import { rockfordRecords } from '../../../../../../data/illinois/counties/winnebago-records';
---
<BaseLayout title="Rockford Surveillance | NoRec.US" description="Publicly documented surveillance technology and primary records for Rockford, Illinois." active="surveillance">
<main class="page_shell">
  <nav class="jurisdiction_breadcrumbs" aria-label="Breadcrumb">
    <a href="/illinois/">Illinois</a><span>→</span><a href="/illinois/counties/winnebago/">Winnebago County</a><span>→</span><strong>Rockford</strong>
  </nav>

  <header class="article_header">
    <p class="eyebrow">LOCAL SURVEILLANCE · ROCKFORD, ILLINOIS</p>
    <h1>Rockford</h1>
    <p class="article_deck">Municipal findings for the City of Rockford and Rockford Police Department. County-owned systems are documented separately on the Winnebago County page.</p>
  </header>

  <section>
    <p class="eyebrow">ROCKFORD POLICE DEPARTMENT</p>
    <h2>Documented surveillance systems.</h2>
    <div class="finding_grid">
      {rockfordFindings.map(finding => (
        <article>
          <span class="status_label">{finding.status.toUpperCase()}</span>
          <p class="eyebrow finding_technology">{finding.technology}</p>
          <h3>{finding.title}</h3>
          <p>{finding.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <PublicRecords records={rockfordRecords} />

  <section>
    <p class="eyebrow">UNRESOLVED</p>
    <h2>What the current primary records do not yet answer.</h2>
    <ul class="about_questions">
      <li>The current ALPR inventory divided among fixed, mobile, and Flock-operated devices.</li>
      <li>Exact locations and current sharing configuration for Rockford ALPR systems.</li>
      <li>The vendor, product, query rules, source platforms, and retention rules for social-media analytics.</li>
      <li>The current vendor, policy, retention rules, and alert-review process for gunshot detection.</li>
      <li>Complete current drone inventory, payloads, policies, and flight records.</li>
      <li>Current fixed-camera inventory, ownership, retention, and access rules.</li>
    </ul>
  </section>

  <section class="evidence_box">
    <span class="status_label">CONTRIBUTE</span>
    <p>This jurisdiction file is community-maintained. Primary records, corrections, and missing technology categories are welcome.</p>
    <a class="button button_light" href="https://github.com/yung-megafone/NoRec-US">Contribute on GitHub</a>
  </section>
</main>
</BaseLayout>
