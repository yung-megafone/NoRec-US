---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommunityLinks from '../../components/CommunityLinks.astro';

const countyRows = [["Jo Daviess", "Stephenson", "Winnebago", "Boone", "McHenry", "Lake"],
 ["Carroll", "Ogle", "DeKalb", "Kane", "DuPage", "Cook"],
 ["Whiteside", "Lee", "Kendall", "Will"],
 ["Rock Island", "Henry", "Bureau", "LaSalle", "Grundy", "Kankakee"],
 ["Mercer", "Knox", "Stark", "Marshall", "Putnam", "Livingston", "Iroquois"],
 ["Henderson", "Warren", "Peoria", "Woodford", "McLean", "Ford"],
 ["Hancock", "McDonough", "Fulton", "Tazewell", "Mason", "Logan", "DeWitt", "Champaign", "Vermilion"],
 ["Adams", "Schuyler", "Brown", "Cass", "Menard", "Sangamon", "Macon", "Piatt", "Douglas", "Edgar"],
 ["Pike", "Scott", "Morgan", "Christian", "Moultrie", "Coles", "Clark"],
 ["Calhoun", "Greene", "Macoupin", "Montgomery", "Shelby", "Cumberland"],
 ["Jersey", "Madison", "Bond", "Fayette", "Effingham", "Jasper", "Crawford"],
 ["St. Clair", "Clinton", "Marion", "Clay", "Richland", "Lawrence"],
 ["Monroe", "Washington", "Jefferson", "Wayne", "Edwards", "Wabash"],
 ["Randolph", "Perry", "Franklin", "Hamilton", "White"],
 ["Jackson", "Williamson", "Saline", "Gallatin"],
 ["Union", "Johnson", "Pope", "Hardin"],
 ["Alexander", "Pulaski", "Massac"]];
const researchedCounties = new Set(['Winnebago', 'Boone', 'Ogle', 'Lee', 'Kendall', 'DeKalb', 'Kane', 'McHenry']);
const countySlug = (name: string) => name.toLowerCase().replace(/\./g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const counties = countyRows.flat().sort((a, b) => a.localeCompare(b));
---
<BaseLayout
  title="Illinois Surveillance Map | NoRec.US"
  description="Browse NoRec.US surveillance research by Illinois county and contribute records for counties without published dossiers."
  active="surveillance"
>
<main class="page_shell county_map_page">
  <header class="article_header">
    <p class="eyebrow">ILLINOIS · COUNTY MAP</p>
    <h1>Illinois surveillance research.</h1>
    <p class="article_deck">Start at the state level, then drill into county and municipal surveillance research. Counties without published research remain visibly unresearched rather than being treated as surveillance-free.</p>
  </header>

  <section class="map_legend" aria-label="Map legend">
    <span><i class="legend_swatch legend_covered"></i><strong>Jurisdiction file available</strong></span>
    <span><i class="legend_swatch legend_open"></i><strong>Coverage needed</strong></span>
  </section>

  <section>
    <div class="county_map_intro">
      <div>
        <p class="eyebrow">COUNTIES</p>
        <h2>Illinois, north to south.</h2>
      </div>
    </div>

    <div class="county_cartogram" role="group" aria-label="Illinois county coverage map">
      {countyRows.map((row, rowIndex) => (
        <div class={`county_map_row county_map_row_${rowIndex + 1}`}>
          {row.map(county => {
            const href = `/illinois/counties/${countySlug(county)}/`;
            const covered = researchedCounties.has(county);
            return (
              <a
                class:list={['county_tile', covered ? 'county_tile_covered' : 'county_tile_open']}
                href={href}
                aria-label={covered
                  ? `${county} County — jurisdiction file available`
                  : `${county} County — research needed`}
              >
                <strong>{county}</strong>
                <span>{covered ? 'DATA' : 'OPEN'}</span>
              </a>
            );
          })}
        </div>
      ))}
    </div>

    <p class="map_note">County positions are approximate.</p>
  </section>

  <section>
    <p class="eyebrow">CURRENT COVERAGE</p>
    <h2>Published county dossiers</h2>
    <div class="jurisdiction_cards">
      <a href="/illinois/counties/winnebago/"><strong>Winnebago County</strong><span>Winnebago County Sheriff · Rockford Police · Flock · Axon · drones · cameras · analytics</span></a>
      <a href="/illinois/counties/boone/"><strong>Boone County</strong><span>Boone County Sheriff's Office · Belvidere Police · Flock ALPR · Policy 450 · retention · audits · locations</span></a>
      <a href="/illinois/counties/ogle/"><strong>Ogle County</strong><span>Municipality directory · GIS boundaries · Sheriff FOIA portal · primary-record research queue</span></a>
      <a href="/illinois/counties/lee/"><strong>Lee County</strong><span>Lee County Sheriff · Flock LPR · UAS policy · Dixon · municipality directory · FOIA sources</span></a>
      <a href="/illinois/counties/kendall/"><strong>Kendall County</strong><span>KenCom regional Flock LPR · Sheriff UAS policy · Oswego · Plano · Yorkville · municipality directory · FOIA sources</span></a>
      <a href="/illinois/counties/dupage/"><strong>DuPage County</strong><span>39 municipalities · county campus LPR · Wheaton Flock · Naperville ALPR/RTCC · Elmhurst ALPR/drone records</span></a>
      <a href="/illinois/counties/dekalb/"><strong>DeKalb County</strong><span>DeKalb Police · County Sheriff · Genetec · Flock · Axon · Fusus · Fleet 3 · drones</span></a>
      <a href="/illinois/counties/kane/"><strong>Kane County</strong><span>Kane County Sheriff · Flock · Getac · Evidence.com · municipal drones</span></a>
      <a href="/illinois/counties/mchenry/"><strong>McHenry County</strong><span>30 municipalities · Sheriff video/UAS · Huntley · Crystal Lake · Woodstock · full municipal audit</span></a>
      <a href="/illinois/counties/lake/"><strong>Lake County</strong><span>52 municipalities · Sheriff UAS policy · Mundelein · Vernon Hills · Lake Zurich · Waukegan · Gurnee · Libertyville · Antioch</span></a>
    </div>
  </section>

  <section class="evidence_box">
    <span class="status_label">CONTRIBUTE</span>
    <p>Contributions can start with a single primary record: a contract, procurement notice, board packet, policy, annual report, FOIA response, audit, camera inventory, drone report, or other government document.</p>
    <CommunityLinks compact={true} githubLabel="Contribute county records" telegramLabel="Send a lead in Telegram" />
  </section>

  <details class="county_accessible_list">
    <summary>Alphabetical county list</summary>
    <ul>
      {counties.map(county => {
        const href = `/illinois/counties/${countySlug(county)}/`;
        const covered = researchedCounties.has(county);
        return (
          <li>
            <a href={href}>
              <strong>{county} County</strong>
              <span>{covered ? 'Dossier available' : 'Research needed'}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </details>
</main>
</BaseLayout>
