---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { rungMeta, surveillanceCatalog, type SurveillanceRung } from '../../data/surveillanceCatalog';

const rungOrder: SurveillanceRung[] = ['government', 'workplace', 'consumer', 'private', 'infrastructure'];
const confirmedIllinois = surveillanceCatalog.filter((entry) => entry.applicability.includes('CONFIRMED IL DEPLOYMENT')).length;
const federal = surveillanceCatalog.filter((entry) => entry.governmentLevel === 'federal-national').length;
---
<BaseLayout
  title="Surveillance Affecting Illinois Residents | NoRec.US"
  description="A source-backed directory of government, workplace, consumer, private, and commercial surveillance technologies that affect people in Illinois."
>
  <main class="page_shell surveillance_hub">
    <header class="article_header surveillance_index_header">
      <p class="eyebrow">ILLINOIS SURVEILLANCE INDEX</p>
      <h1>Who’s watching you?</h1>
      <p class="article_deck">Surveillance does not begin or end with police. NoRec documents the systems that can monitor, identify, locate, profile, score, or influence people in Illinois — and separates confirmed Illinois deployment from national capability, research, and unresolved questions.</p>
    </header>

    <section class="surveillance_scope">
      <div class="evidence_box">
        <span class="status_label">SCOPE</span>
        <p>This directory follows the relationship between the person being watched and the watcher: government, employer, business, private party, or data intermediary. One system may cross several rungs as data moves between them.</p>
      </div>
      <div class="surveillance_stats">
        <div><strong>{surveillanceCatalog.length}</strong><span>tracked entries</span></div>
        <div><strong>{confirmedIllinois}</strong><span>confirmed IL deployments</span></div>
        <div><strong>{federal}</strong><span>federal entries seeded</span></div>
      </div>
    </section>

    <section class="surveillance_principle">
      <p class="eyebrow">WHY THIS MATTERS</p>
      <h2>Privacy is not only about hiding information.</h2>
      <p>Information changes bargaining power. Surveillance can affect what price you see, how an employer evaluates you, whether a system flags your behavior, what a retailer infers about you, or what an investigator can reconstruct later.</p>
    </section>

    <section aria-labelledby="rungs-heading">
      <p class="eyebrow">SURVEILLANCE RUNGS</p>
      <h2 id="rungs-heading">The technologies monitoring you at each level.</h2>
      <div class="rung_stack">
        {rungOrder.map((rung, index) => {
          const meta = rungMeta[rung];
          const entries = surveillanceCatalog.filter((entry) => entry.rung === rung);
          return (
            <details class={`rung_panel rung_${rung}`} open={index === 0}>
              <summary>
                <span class="rung_index">0{index + 1}</span>
                <span class="rung_title"><strong>{meta.label}</strong><small>{meta.question}</small></span>
                <span class="rung_count">{entries.length}</span>
              </summary>
              <div class="rung_body">
                <p class="rung_description">{meta.description}</p>
                {rung === 'government' && (
                  <div class="level_key" aria-label="Government levels">
                    <span>LOCAL / COUNTY</span><span>ILLINOIS STATE</span><span>FEDERAL / NATIONAL</span>
                  </div>
                )}
                <div class="rung_entries">
                  {entries.map((entry) => (
                    <article class="rung_entry">
                      <div class="rung_entry_top">
                        <div>
                          <span class="surveillance_category">{entry.category}</span>
                          <h3>{entry.name}</h3>
                        </div>
                        <span class="surveillance_state">{entry.status}</span>
                      </div>
                      <p>{entry.summary}</p>
                      <div class="applicability_tags">
                        {entry.governmentLevel && <span>{entry.governmentLevel.replace('-', ' / ').toUpperCase()}</span>}
                        {entry.applicability.map((tag) => <span>{tag}</span>)}
                      </div>
                      <dl class="encounter_grid">
                        <div><dt>HOW YOU ENCOUNTER IT</dt><dd>{entry.encounter}</dd></div>
                        <div><dt>DATA</dt><dd>{entry.dataCollected.join(' · ')}</dd></div>
                      </dl>
                      <div class="rung_actions">
                        <a href={entry.detailHref ?? `/surveillance/systems/${entry.slug}/`}>Open entry →</a>
                        {entry.entities?.slice(0, 2).map((entity) => <a class="muted_link" href={`/surveillance/entities/${entity.slug}/`}>{entity.name}</a>)}
                      </div>
                    </article>
                  ))}
                </div>
                <a class="button button_light rung_browse" href={`/surveillance/${rung}/`}>Browse {meta.label.toLowerCase()} →</a>
              </div>
            </details>
          );
        })}
      </div>
    </section>

    <section class="surveillance_method">
      <p class="eyebrow">READ THE BADGES</p>
      <h2>Capability is not deployment.</h2>
      <p>NoRec distinguishes confirmed Illinois deployment, Illinois agency access, Illinois-resident data collection, nationwide applicability, historical use, and research without a known Illinois deployment. Vendor documentation proves capability; it does not prove that every feature was purchased, enabled, or used.</p>
    </section>

    <section class="provider_directory">
      <p class="eyebrow">RESEARCH PATHS</p>
      <h2>Follow the system, provider, operator, or place.</h2>
      <div class="provider_grid">
        <a href="/illinois/"><strong>Illinois map</strong><span>What is documented where.</span></a>
        <a href="/surveillance/jurisdictions/"><strong>Jurisdictions</strong><span>Local and state agency dossiers.</span></a>
        <a href="/providers/flock-safety/"><strong>Existing providers</strong><span>Vendor relationships and product capability.</span></a>
        <a href="/surveillance/entities/darpa/"><strong>Programs & entities</strong><span>Agencies, programs, platforms, and infrastructure that are not vendors.</span></a>
      </div>
    </section>
  </main>
</BaseLayout>
