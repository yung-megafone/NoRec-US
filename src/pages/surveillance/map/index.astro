---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CommunityLinks from '../../../components/CommunityLinks.astro';

const contributeUrl = 'https://github.com/yung-megafone/NoRec-US';
const countyRows = [["Jo Daviess", "Stephenson", "Winnebago", "Boone", "McHenry", "Lake"],
 ["Carroll", "Ogle", "DeKalb", "Kane", "DuPage", "Cook"],
 ["Whiteside", "Lee", "Kendall", "Will"],
 ["Rock Island", "Henry", "Bureau", "LaSalle", "Grundy", "Kankakee"],
 ["Mercer", "Knox", "Stark", "Marshall", "Putnam", "Livingston", "Iroquois"],
 ["Henderson", "Warren", "Peoria", "Woodford", "McLean", "Ford"],
 ["Hancock", "McDonough", "Fulton", "Tazewell", "Mason", "Logan", "DeWitt", "Champaign", "Vermilion"],
 ["Adams", "Schuyler", "Brown", "Cass", "Menard", "Sangamon", "Macon", "Piatt", "Douglas", "Edgar"],
 ["Pike", "Scott", "Morgan", "Christian", "Moultrie", "Coles", "Clark"],
 ["Calhoun", "Greene", "Macoupin", "Montgomery", "Shelby", "Cumberland"],
 ["Jersey", "Madison", "Bond", "Fayette", "Effingham", "Jasper", "Crawford"],
 ["St. Clair", "Clinton", "Marion", "Clay", "Richland", "Lawrence"],
 ["Monroe", "Washington", "Jefferson", "Wayne", "Edwards", "Wabash"],
 ["Randolph", "Perry", "Franklin", "Hamilton", "White"],
 ["Jackson", "Williamson", "Saline", "Gallatin"],
 ["Union", "Johnson", "Pope", "Hardin"],
 ["Alexander", "Pulaski", "Massac"]];
const countyPages: Record<string, { href: string; zip: string }> = {
  Winnebago: { href: '/county/61101/', zip: '61101' },
  Boone: { href: '/county/61008/', zip: '61008' },
  DeKalb: { href: '/county/60178/', zip: '60178' },
  Kane: { href: '/county/60134/', zip: '60134' },
  McHenry: { href: '/county/60098/', zip: '60098' }
};
const counties = countyRows.flat().sort((a, b) => a.localeCompare(b));
---
<BaseLayout
  title="Illinois Surveillance Map | NoRec.US"
  description="Browse NoRec.US surveillance research by Illinois county and contribute records for counties without published dossiers."
  active="surveillance"
>
<main class="page_shell county_map_page">
  <header class="article_header">
    <p class="eyebrow">ILLINOIS · COUNTY MAP</p>
    <h1>Pick a county.</h1>
    <p class="article_deck">Browse published county research or contribute records for counties without a dossier.</p>
  </header>

  <section class="map_legend" aria-label="Map legend">
    <span><i class="legend_swatch legend_covered"></i><strong>Jurisdiction file available</strong></span>
    <span><i class="legend_swatch legend_open"></i><strong>Coverage needed</strong></span>
  </section>

  <section>
    <div class="county_map_intro">
      <div>
        <p class="eyebrow">COUNTIES</p>
        <h2>Illinois, north to south.</h2>
      </div>
    </div>

    <div class="county_cartogram" role="group" aria-label="Illinois county coverage map">
      {countyRows.map((row, rowIndex) => (
        <div class={`county_map_row county_map_row_${rowIndex + 1}`}>
          {row.map(county => {
            const countyPage = countyPages[county];
            const href = countyPage?.href ?? contributeUrl;
            const covered = Boolean(countyPage);
            return (
              <a
                class:list={['county_tile', covered ? 'county_tile_covered' : 'county_tile_open']}
                href={href}
                rel={covered ? undefined : 'external'}
                aria-label={covered
                  ? `${county} County — jurisdiction file available`
                  : `${county} County — coverage needed; contribute on GitHub`}
              >
                <strong>{county}</strong>
                <span>{covered ? countyPage?.zip : '+'}</span>
              </a>
            );
          })}
        </div>
      ))}
    </div>

    <p class="map_note">County positions are approximate.</p>
  </section>

  <section>
    <p class="eyebrow">CURRENT COVERAGE</p>
    <h2>Published county dossiers</h2>
    <div class="jurisdiction_cards">
      <a href="/county/61101/"><strong>Winnebago County</strong><span>Winnebago County Sheriff · Rockford Police · Flock · Axon · drones · cameras · analytics</span></a>
      <a href="/county/61008/"><strong>Boone County</strong><span>Boone County Sheriff's Office · Belvidere Police · Flock ALPR · Policy 450 · retention · audits · locations</span></a>
      <a href="/county/60178/"><strong>DeKalb County</strong><span>DeKalb Police · County Sheriff · Genetec · Flock · Axon · Fusus · Fleet 3 · drones</span></a>
      <a href="/county/60134/"><strong>Kane County</strong><span>Kane County Sheriff · Flock · Getac · Evidence.com · municipal drones</span></a>
      <a href="/county/60098/"><strong>McHenry County</strong><span>McHenry County Sheriff's Office · Huntley Police · ALPR · drones · body/in-car video · Evidence.com</span></a>
    </div>
  </section>

  <section class="evidence_box">
    <span class="status_label">CONTRIBUTE</span>
    <p>Contributions can start with a single primary record: a contract, procurement notice, board packet, policy, annual report, FOIA response, audit, camera inventory, drone report, or other government document.</p>
    <CommunityLinks compact={true} githubLabel="Contribute county records" telegramLabel="Send a lead in Telegram" />
  </section>

  <details class="county_accessible_list">
    <summary>Alphabetical county list</summary>
    <ul>
      {counties.map(county => {
        const href = countyPages[county] ?? contributeUrl;
        const covered = Boolean(countyPages[county]);
        return (
          <li>
            <a href={href} rel={covered ? undefined : 'external'}>
              <strong>{county} County</strong>
              <span>{covered ? 'Dossier available' : 'Contribute information'}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </details>
</main>
</BaseLayout>
